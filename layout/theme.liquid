<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0a0f0e">

  <title>
    {{ page_title -}}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{%- endif -%}
    {%- if current_page != 1 %} &ndash; Pagina {{ current_page }}{%- endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{%- endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    (function(){
      var t = localStorage.getItem('pb-theme');
      if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
    }());
  </script>
</head>
<body class="template-{{ template.name }}">

  {% section 'header' %}

  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}

  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <div class="mobile-nav-header">
      <a href="{{ routes.root_url }}" class="header-logo-wrap" aria-label="{{ shop.name }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 200 | image_tag: class: 'header-logo-img', alt: shop.name }}
        {%- else -%}
          <span class="header-logo-text" style="color:var(--accent)">{{ shop.name | upcase }}</span>
        {%- endif -%}
      </a>
      <button class="cart-close-btn" id="mobile-nav-close" aria-label="Menu sluiten">&#x2715;</button>
    </div>
    <nav class="mobile-nav-links">
      {%- for link in linklists['main-menu'].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      {%- assign mob_has_over_ons = false -%}
      {%- assign mob_has_contact = false -%}
      {%- for link in linklists['main-menu'].links -%}
        {%- if link.title == 'Over ons' or link.title == 'Over Ons' -%}{%- assign mob_has_over_ons = true -%}{%- endif -%}
        {%- if link.title == 'Contact' or link.title == 'contact' -%}{%- assign mob_has_contact = true -%}{%- endif -%}
      {%- endfor -%}
      {%- unless mob_has_over_ons -%}
        {%- if pages['over-ons'] -%}<a href="{{ pages['over-ons'].url }}">Over ons</a>{%- endif -%}
      {%- endunless -%}
      {%- unless mob_has_contact -%}
        {%- if pages['contact'] -%}<a href="{{ pages['contact'].url }}">Contact</a>{%- endif -%}
      {%- endunless -%}
    </nav>
  </div>

  <div class="cart-overlay" id="cart-overlay" aria-hidden="true"></div>

  {%- if settings.whatsapp_number != blank -%}
    <a href="https://wa.me/{{ settings.whatsapp_number }}"
       target="_blank"
       rel="noopener"
       class="wa-btn"
       aria-label="Neem contact op via WhatsApp">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
      <span class="wa-btn-label">WhatsApp</span>
    </a>
  {%- endif -%}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
