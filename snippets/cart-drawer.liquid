<div class="cart-drawer" id="cart-drawer" role="dialog" aria-label="Winkelwagen" aria-hidden="true">
  <div class="cart-drawer-header">
    <p class="cart-drawer-title">Winkelwagen</p>
    <button class="cart-close-btn" id="cart-drawer-close" aria-label="Winkelwagen sluiten">&#x2715;</button>
  </div>
  <div class="cart-items" id="cart-drawer-items">
    <p class="cart-empty">Je winkelwagen is leeg.</p>
  </div>
  <div class="cart-footer">
    <div class="cart-subtotal">
      <span class="cart-subtotal-label">Subtotaal</span>
      <span class="cart-subtotal-value" id="cart-subtotal-value">{{ 0 | money }}</span>
    </div>
    <a href="{{ routes.cart_url }}" class="btn-checkout">Afrekenen</a>
  </div>
</div>
