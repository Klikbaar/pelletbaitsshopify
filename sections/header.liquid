<header class="site-header" role="banner">
  <div class="container">
    <div class="header-inner">
      <a href="{{ routes.root_url }}" class="header-logo-wrap" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 200 | image_tag: class: 'header-logo-img', alt: shop.name }}
        {%- else -%}
          <span class="header-logo-text" style="color:var(--accent)">{{ shop.name | upcase }}</span>
        {%- endif -%}
      </a>

      <nav class="header-nav" role="navigation" aria-label="Hoofdmenu">
        {%- assign has_over_ons = false -%}
        {%- assign has_contact = false -%}
        {%- assign has_tools = false -%}
        {%- for link in linklists[section.settings.menu].links -%}
          {%- assign lt = link.title | downcase -%}
          {%- if lt == 'over ons' -%}{%- assign has_over_ons = true -%}{%- endif -%}
          {%- if lt == 'contact' -%}{%- assign has_contact = true -%}{%- endif -%}
          {%- if lt == 'tools & merchandise' or lt == 'tools en merchandise' -%}{%- assign has_tools = true -%}{%- endif -%}
        {%- endfor -%}

        {# Contact — helemaal links #}
        {%- if has_contact -%}
          {%- for link in linklists[section.settings.menu].links -%}
            {%- if link.title | downcase == 'contact' -%}
              <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif pages['contact'] -%}
          <a href="{{ pages['contact'].url }}"{% if request.page_type == 'page' and page.handle == 'contact' %} aria-current="page"{% endif %}>Contact</a>
        {%- endif -%}

        {# Overige menulinks; Tools & Merchandise direct na KOI ingevoegd #}
        {%- assign tools_placed = false -%}
        {%- for link in linklists[section.settings.menu].links -%}
          {%- assign lt = link.title | downcase -%}
          {%- unless lt == 'contact' or lt == 'tools & merchandise' or lt == 'tools en merchandise' -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if lt == 'koi' -%}
              {%- if has_tools -%}
                {%- for tl in linklists[section.settings.menu].links -%}
                  {%- assign tlt = tl.title | downcase -%}
                  {%- if tlt == 'tools & merchandise' or tlt == 'tools en merchandise' -%}
                    <a href="{{ tl.url }}"{% if tl.active %} aria-current="page"{% endif %}>{{ tl.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif collections['tools-merchandise'] -%}
                <a href="{{ collections['tools-merchandise'].url }}"{% if request.page_type == 'collection' and collection.handle == 'tools-merchandise' %} aria-current="page"{% endif %}>Tools &amp; Merchandise</a>
              {%- endif -%}
              {%- assign tools_placed = true -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}

        {# Fallback: Tools & Merchandise achteraan als KOI niet in menu staat #}
        {%- unless tools_placed -%}
          {%- if has_tools -%}
            {%- for link in linklists[section.settings.menu].links -%}
              {%- assign lt = link.title | downcase -%}
              {%- if lt == 'tools & merchandise' or lt == 'tools en merchandise' -%}
                <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
              {%- endif -%}
            {%- endfor -%}
          {%- elsif collections['tools-merchandise'] -%}
            <a href="{{ collections['tools-merchandise'].url }}"{% if request.page_type == 'collection' and collection.handle == 'tools-merchandise' %} aria-current="page"{% endif %}>Tools &amp; Merchandise</a>
          {%- endif -%}
        {%- endunless -%}

        {# Over ons fallback #}
        {%- unless has_over_ons -%}
          {%- if pages['over-ons'] -%}
            <a href="{{ pages['over-ons'].url }}"{% if request.page_type == 'page' and page.handle == 'over-ons' %} aria-current="page"{% endif %}>Over ons</a>
          {%- endif -%}
        {%- endunless -%}
      </nav>

      <div class="header-actions">
        <button class="theme-toggle-btn" id="theme-toggle" aria-label="Schakel thema">
          <span class="theme-icon theme-icon--moon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </span>
          <span class="theme-icon theme-icon--sun" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </span>
        </button>

        <button class="header-cart-btn" data-cart-open aria-label="Winkelwagen openen">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/>
          </svg>
          Cart
          <span class="cart-count" id="cart-count" style="display:none">0</span>
        </button>

        <button class="mobile-menu-btn" id="mobile-nav-open" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-nav">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
