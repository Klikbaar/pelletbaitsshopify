<header class="site-header" role="banner">
  <div class="container">
    <div class="header-inner">
      <a href="{{ routes.root_url }}" class="header-logo-wrap" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 200 | image_tag: class: 'header-logo-img', alt: shop.name }}
        {%- else -%}
          <span class="header-logo-text" style="color:var(--accent)">{{ shop.name | upcase }}</span>
        {%- endif -%}
      </a>

      <nav class="header-nav" role="navigation" aria-label="Hoofdmenu">
        <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>Home</a>
        <a href="/collections"{% if request.page_type == 'list-collections' or request.page_type == 'collection' %} aria-current="page"{% endif %}>Shop</a>
        {%- if pages['over-ons'] -%}
          <a href="{{ pages['over-ons'].url }}"{% if request.page_type == 'page' and page.handle == 'over-ons' %} aria-current="page"{% endif %}>Over ons</a>
        {%- else -%}
          <a href="/pages/over-ons">Over ons</a>
        {%- endif -%}
        {%- if pages['klantenservice'] -%}
          <a href="{{ pages['klantenservice'].url }}"{% if request.page_type == 'page' and page.handle == 'klantenservice' %} aria-current="page"{% endif %}>Klantenservice</a>
        {%- else -%}
          <a href="/pages/klantenservice">Klantenservice</a>
        {%- endif -%}
        {%- if pages['contact'] -%}
          <a href="{{ pages['contact'].url }}"{% if request.page_type == 'page' and page.handle == 'contact' %} aria-current="page"{% endif %}>Contact</a>
        {%- else -%}
          <a href="/pages/contact">Contact</a>
        {%- endif -%}
      </nav>

      <div class="header-actions">
        {%- if shop.published_locales.size > 1 -%}
          <div class="header-lang-select" id="lang-select-wrap">
            {%- form 'localization', id: 'header-locale-form' -%}
              <button type="button" class="header-lang-btn" aria-expanded="false" aria-controls="lang-dropdown" id="lang-btn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                {{ request.locale.iso_code | upcase }}
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="lang-chevron" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <ul id="lang-dropdown" class="lang-dropdown" hidden>
                {%- for locale in shop.published_locales -%}
                  <li>
                    <button type="submit" name="locale_code" value="{{ locale.iso_code }}"{% if locale.iso_code == request.locale.iso_code %} aria-current="true"{% endif %}>
                      {{ locale.endonym_name }}
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endform -%}
          </div>
        {%- else -%}
          <span class="header-lang-btn header-lang-static">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            NL
          </span>
        {%- endif -%}

        <button class="theme-toggle-btn" id="theme-toggle" aria-label="Schakel thema">
          <span class="theme-icon theme-icon--moon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </span>
          <span class="theme-icon theme-icon--sun" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          </span>
        </button>

        <button class="header-cart-btn" data-cart-open aria-label="Winkelwagen openen">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/>
          </svg>
          Cart
          <span class="cart-count" id="cart-count" style="display:none">0</span>
        </button>

        <button class="mobile-menu-btn" id="mobile-nav-open" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-nav">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    {%- if section.settings.categories_menu != blank and linklists[section.settings.categories_menu].links.size > 0 -%}
      <nav class="header-cats" aria-label="Productcategorieën">
        {%- for link in linklists[section.settings.categories_menu].links -%}
          <a href="{{ link.url }}" class="header-cat-link"{% if link.active %} aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "categories_menu",
      "label": "Categorieënbalk (onder header)"
    }
  ]
}
{% endschema %}
