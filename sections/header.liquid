{%- if section.settings.show_promobar -%}
<div class="pb-promobar" role="complementary" aria-label="Aankondigingen">
  <div class="pb-container pb-promobar-inner">
    <div class="pb-promo-row">
      <div class="pb-promo-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/></svg>
        <span>Gratis verzending vanaf €60</span>
      </div>
      <div class="pb-promo-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Voor 16:00 besteld, morgen in huis</span>
      </div>
      <div class="pb-promo-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M9 13.5L7 21l5-3 5 3-2-7.5"/></svg>
        <span>Officieel Alltech Coppens distributeur</span>
      </div>
      <div class="pb-promo-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M22 17v3a2 2 0 0 1-2.2 2A19 19 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L7.9 9.7a16 16 0 0 0 6.4 6.4l1.3-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6A2 2 0 0 1 22 17z"/></svg>
        <span>Advies? Bel op werkdagen 9–17u</span>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

<header class="site-header" role="banner">
  <div class="header-main-row">
    <div class="pb-container header-inner">

      <a href="{{ routes.root_url }}" class="header-logo-wrap" aria-label="{{ shop.name }} — home">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 240 | image_tag: class: 'header-logo-img', alt: shop.name }}
        {%- else -%}
          <img src="{{ 'logo-pelletbaits-dark.png' | asset_url }}" class="header-logo-img" alt="{{ shop.name }}" width="180" height="auto" loading="eager">
        {%- endif -%}
      </a>

      <form action="{{ routes.search_url }}" method="get" role="search" class="pb-search">
        <span class="pb-search-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input type="search" name="q" placeholder="Zoek pellets, boilies, vissoort…" aria-label="Zoeken" autocomplete="off">
        <button type="submit" class="pb-search-btn">Zoek</button>
      </form>

      <div class="header-actions">
        <div class="header-accent-links">
          <a href="{{ pages['clinics'].url | default: '/pages/clinics' }}"
             class="header-accent-link{% if request.path contains 'clinics' %} active{% endif %}">Clinics</a>
          <a href="{{ pages['zakelijk'].url | default: '/pages/zakelijk' }}"
             class="header-accent-link{% if request.path contains 'zakelijk' %} active{% endif %}">Zakelijk</a>
        </div>

        {%- form 'localization', id: 'HeaderLocalizationForm' -%}
          {%- assign cur_iso = localization.language.iso_code -%}
          <div class="header-lang-wrap" id="lang-wrap">
            <button type="button" class="header-lang-btn" id="lang-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Taal kiezen">
              {%- if cur_iso == 'en' -%}
                <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="40" fill="#012169"/><path d="M0 0l60 40M60 0L0 40" stroke="#fff" stroke-width="6"/><path d="M0 0l60 40M60 0L0 40" stroke="#c8102e" stroke-width="3"/><path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="10"/><path d="M30 0v40M0 20h60" stroke="#c8102e" stroke-width="6"/></svg>
              {%- elsif cur_iso == 'de' -%}
                <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="13.3" fill="#000"/><rect y="13.3" width="60" height="13.3" fill="#dd0000"/><rect y="26.7" width="60" height="13.3" fill="#ffce00"/></svg>
              {%- else -%}
                <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="40" fill="#fff"/><rect width="60" height="13.3" fill="#ae1c28"/><rect y="26.7" width="60" height="13.3" fill="#21468b"/></svg>
              {%- endif -%}
              <span>{{ cur_iso | upcase }}</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="header-lang-dropdown" id="lang-dropdown" role="listbox" aria-label="Taal kiezen">
              <!-- DEBUG-TALEN: {{ localization.available_languages | map: 'iso_code' | join: ', ' }} (totaal: {{ localization.available_languages.size }}) -->
              {%- if localization.available_languages.size > 1 -%}
                {%- for language in localization.available_languages -%}
                  <button type="submit" name="locale_code" value="{{ language.iso_code }}"
                          class="header-lang-option{% if language.iso_code == cur_iso %} active{% endif %}"
                          role="option" aria-selected="{% if language.iso_code == cur_iso %}true{% else %}false{% endif %}">
                    {%- if language.iso_code == 'en' -%}
                      <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="40" fill="#012169"/><path d="M0 0l60 40M60 0L0 40" stroke="#fff" stroke-width="6"/><path d="M0 0l60 40M60 0L0 40" stroke="#c8102e" stroke-width="3"/><path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="10"/><path d="M30 0v40M0 20h60" stroke="#c8102e" stroke-width="6"/></svg>
                    {%- elsif language.iso_code == 'de' -%}
                      <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="13.3" fill="#000"/><rect y="13.3" width="60" height="13.3" fill="#dd0000"/><rect y="26.7" width="60" height="13.3" fill="#ffce00"/></svg>
                    {%- else -%}
                      <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="40" fill="#fff"/><rect width="60" height="13.3" fill="#ae1c28"/><rect y="26.7" width="60" height="13.3" fill="#21468b"/></svg>
                    {%- endif -%}
                    {{ language.iso_code | upcase }}
                  </button>
                {%- endfor -%}
              {%- else -%}
                <button type="button" class="header-lang-option active" role="option" aria-selected="true">
                  <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="40" fill="#fff"/><rect width="60" height="13.3" fill="#ae1c28"/><rect y="26.7" width="60" height="13.3" fill="#21468b"/></svg>
                  NL
                </button>
                <button type="button" class="header-lang-option" role="option" aria-selected="false" data-locale="en">
                  <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="40" fill="#012169"/><path d="M0 0l60 40M60 0L0 40" stroke="#fff" stroke-width="6"/><path d="M0 0l60 40M60 0L0 40" stroke="#c8102e" stroke-width="3"/><path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="10"/><path d="M30 0v40M0 20h60" stroke="#c8102e" stroke-width="6"/></svg>
                  EN
                </button>
                <button type="button" class="header-lang-option" role="option" aria-selected="false" data-locale="de">
                  <svg width="20" height="14" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="13.3" fill="#000"/><rect y="13.3" width="60" height="13.3" fill="#dd0000"/><rect y="26.7" width="60" height="13.3" fill="#ffce00"/></svg>
                  DE
                </button>
              {%- endif -%}
            </div>
          </div>
        {%- endform -%}

        <button class="header-cart-btn" data-cart-open aria-label="Winkelwagen openen ({{ cart.item_count }} items)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
          <span class="header-cart-label">Winkelwagen</span>
          <span class="cart-count" id="cart-count" aria-live="polite" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        </button>

        <button class="mobile-menu-btn" id="mobile-nav-open" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-nav">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <nav class="pb-mainnav" aria-label="Hoofdnavigatie">
    <div class="pb-container pb-mainnav-inner">
      <a href="{{ routes.root_url }}"
         class="pb-mainnav-link{% if request.path == '/' %} active{% endif %}"
         {% if request.path == '/' %}aria-current="page"{% endif %}>Home</a>
      <a href="{{ pages['over-ons'].url | default: '/pages/over-ons' }}"
         class="pb-mainnav-link{% if request.path contains 'over-ons' %} active{% endif %}"
         {% if request.path contains 'over-ons' %}aria-current="page"{% endif %}>Over ons</a>
      <a href="{{ pages['contact'].url | default: '/pages/contact' }}"
         class="pb-mainnav-link{% if request.path contains 'contact' %} active{% endif %}"
         {% if request.path contains 'contact' %}aria-current="page"{% endif %}>Contact</a>
      <a href="{{ pages['klantenservice'].url | default: '/pages/klantenservice' }}"
         class="pb-mainnav-link{% if request.path contains 'klantenservice' %} active{% endif %}"
         {% if request.path contains 'klantenservice' %}aria-current="page"{% endif %}>Klantenservice</a>
      <span class="pb-mainnav-divider" aria-hidden="true"></span>
      <a href="{{ collections['karper'].url | default: '/collections/karper' }}"
         class="pb-mainnav-link{% if request.path contains 'karper' %} active{% endif %}"
         {% if request.path contains 'karper' %}aria-current="page"{% endif %}>Karpervissen</a>
      <a href="{{ collections['meerval'].url | default: '/collections/meerval' }}"
         class="pb-mainnav-link{% if request.path contains 'meerval' %} active{% endif %}"
         {% if request.path contains 'meerval' %}aria-current="page"{% endif %}>Meervalvissen</a>
      <a href="{{ collections['steur'].url | default: '/collections/steur' }}"
         class="pb-mainnav-link{% if request.path contains 'steur' %} active{% endif %}"
         {% if request.path contains 'steur' %}aria-current="page"{% endif %}>Steurvissen</a>
      <a href="{{ collections['methodfeeder'].url | default: '/collections/methodfeeder' }}"
         class="pb-mainnav-link{% if request.path contains 'methodfeeder' %} active{% endif %}"
         {% if request.path contains 'methodfeeder' %}aria-current="page"{% endif %}>Method Feeder</a>
      <a href="{{ collections['waggler'].url | default: '/collections/waggler' }}"
         class="pb-mainnav-link{% if request.path contains 'waggler' %} active{% endif %}"
         {% if request.path contains 'waggler' %}aria-current="page"{% endif %}>Waggler</a>
      <a href="{{ collections['koi'].url | default: '/collections/koi' }}"
         class="pb-mainnav-link{% if request.path contains 'koi' %} active{% endif %}"
         {% if request.path contains 'koi' %}aria-current="page"{% endif %}>Koi · Vijver</a>
      <a href="{{ collections['tools-merchandise'].url | default: '/collections/tools-merchandise' }}"
         class="pb-mainnav-link{% if request.path contains 'tools' %} active{% endif %}"
         {% if request.path contains 'tools' %}aria-current="page"{% endif %}>Tools &amp; Merch</a>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (upload officieel logo)"
    },
    {
      "type": "checkbox",
      "id": "show_promobar",
      "label": "Promobalk tonen",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hoofdmenu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Categorie-navigatie (onder header)",
      "info": "Laat leeg voor standaard categorieën"
    }
  ]
}
{% endschema %}
