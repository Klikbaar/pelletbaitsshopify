<style>
  /* ---- Klantenservice Section ---- */
  .ks-hero {
    padding: 80px 0 60px;
    border-bottom: 1px solid var(--line);
  }
  .ks-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 20px;
  }
  .ks-breadcrumb a:hover { color: var(--ink); }
  .ks-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .ks-eyebrow-line {
    width: 32px;
    height: 1px;
    background: var(--accent);
  }
  .ks-contact-pills {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .ks-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-size: 13px;
    color: var(--ink);
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .ks-pill:hover { border-color: var(--accent); background: rgba(99,207,5,.05); }

  /* Quick icon cards */
  .ks-quick-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .ks-quick-card {
    padding: 28px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-2);
    text-align: center;
    transition: border-color .3s, transform .3s;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .ks-quick-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .ks-quick-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    margin-bottom: 14px;
    transition: border-color .3s, background .3s;
  }
  .ks-quick-card:hover .ks-quick-icon {
    border-color: var(--accent);
    background: rgba(99,207,5,.08);
  }

  /* Main layout */
  .ks-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 80px;
    align-items: start;
  }
  .ks-sidebar {
    position: sticky;
    top: 90px;
  }
  .ks-sidebar-nav { display: grid; gap: 6px; }
  .ks-sidebar-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 13px;
    color: var(--ink-2);
    border: 1px solid transparent;
    transition: all .2s;
  }
  .ks-sidebar-link:hover {
    border-color: var(--accent);
    color: var(--ink);
    background: rgba(99,207,5,.05);
  }

  /* Sidebar contact card */
  .ks-contact-card {
    margin-top: 40px;
    padding: 24px;
    border: 1px solid rgba(99,207,5,.22);
    border-left: 3px solid var(--accent);
    border-radius: 14px;
    background: var(--bg-2);
  }
  .ks-contact-card-btn {
    display: block;
    text-align: center;
    padding: 12px;
    border-radius: 999px;
    background: var(--accent);
    color: #0a0f0e;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: background var(--dur-fast) ease;
  }
  .ks-contact-card-btn:hover { background: var(--accent-2); color: #fff; }

  /* Accordion */
  .ks-block {
    border-top: 1px solid var(--line-2);
    cursor: pointer;
  }
  .ks-block-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 0;
    gap: 24px;
  }
  .ks-block-icon {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background .3s, border-color .3s, transform .3s;
  }
  .ks-block.open .ks-block-icon {
    background: var(--accent);
    border-color: var(--accent);
    color: #0a0f0e;
    transform: rotate(180deg);
  }
  .ks-block-body {
    overflow: hidden;
    max-height: 0;
    transition: max-height .4s ease, padding .4s;
  }
  .ks-block.open .ks-block-body { max-height: 700px; padding-bottom: 32px; }

  /* Info callout box */
  .ks-callout {
    padding: 16px 20px;
    border-radius: 10px;
    background: var(--bg-3);
    border: 1px solid var(--line-2);
    font-size: 14px;
    color: var(--ink-2);
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 580px;
    margin-bottom: 16px;
  }
  .ks-callout svg { flex-shrink: 0; margin-top: 2px; }

  /* Retour address card */
  .ks-retour-card {
    padding: 24px;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--bg-2);
    max-width: 380px;
    position: relative;
    overflow: hidden;
  }
  .ks-retour-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--accent);
  }

  /* Stat tiles */
  .ks-tiles-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 560px;
  }
  .ks-tile {
    padding: 18px;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: var(--bg-3);
  }
  .ks-tile-icon {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Payment badges */
  .ks-badges { display: flex; flex-wrap: wrap; gap: 10px; max-width: 560px; }
  .ks-badge {
    padding: 10px 16px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    transition: border-color .2s;
  }
  .ks-badge:hover { border-color: var(--accent); }

  /* Size pills */
  .ks-sizes { display: flex; flex-wrap: wrap; gap: 10px; max-width: 560px; }
  .ks-size {
    padding: 12px 18px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
  }
  .ks-size--emmer {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Responsive */
  @media(max-width:980px) { .ks-quick-grid { grid-template-columns: 1fr 1fr 1fr; } }
  @media(max-width:860px) {
    .ks-grid { grid-template-columns: 1fr; }
    .ks-sidebar { position: static; }
  }
  @media(max-width:600px) { .ks-quick-grid { grid-template-columns: 1fr 1fr; } }
  @media(max-width:400px) { .ks-quick-grid { grid-template-columns: 1fr; } }
</style>

<!-- HERO -->
<header class="ks-hero">
  <div class="container">
    <div class="ks-breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>·</span>
      <span style="color:var(--ink)">Klantenservice</span>
    </div>
    <div class="ks-eyebrow-row">
      <span class="ks-eyebrow-line"></span>
      <span class="eyebrow">Support</span>
    </div>
    <h1 class="display" style="font-size:clamp(56px,9vw,140px);margin:0;padding-bottom:.1em">
      Klanten<span style="color:var(--accent)">service</span>
    </h1>
    <p style="margin-top:24px;max-width:560px;font-size:16px;line-height:1.65;color:var(--ink-2);font-weight:300">
      Alles over bestellen, betalen, verzenden en retourneren. Kom je er niet uit? Stuur ons een bericht.
    </p>
    <div class="ks-contact-pills">
      {%- if settings.email != blank -%}
        <a href="mailto:{{ settings.email }}" class="ks-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          {{ settings.email }}
        </a>
      {%- endif -%}
      {%- if settings.phone != blank -%}
        <a href="tel:{{ settings.phone | remove: ' ' | remove: '-' }}" class="ks-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
          Bel direct
        </a>
      {%- endif -%}
    </div>
  </div>
</header>

