<!-- ACCORDION + SIDEBAR -->
<section style="padding:80px 0">
  <div class="container">
    <div class="ks-grid">

      <!-- Sticky sidebar -->
      <div class="ks-sidebar">
        <div class="eyebrow" style="margin-bottom:20px;color:var(--accent)">Onderwerpen</div>
        <div class="ks-sidebar-nav">
          <a href="#bestellen" class="ks-sidebar-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
            Bestellen
          </a>
          <a href="#prijzen" class="ks-sidebar-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M15 9.5a3 3 0 1 0 0 5M12 7v1M12 16v1"/></svg>
            Prijzen
          </a>
          <a href="#betaling" class="ks-sidebar-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            Betaling
          </a>
          <a href="#verzenden" class="ks-sidebar-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/></svg>
            Verzenden
          </a>
          <a href="#retourneren" class="ks-sidebar-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Retourneren
          </a>
          <a href="#verpakking" class="ks-sidebar-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7l9-4 9 4-9 4-9-4zM3 7v10l9 4 9-4V7"/></svg>
            Verpakking
          </a>
        </div>

        <!-- Contact card -->
        <div class="ks-contact-card">
          <div class="display" style="font-size:20px;margin-bottom:12px">Hulp nodig?</div>
          <p style="font-size:13px;color:var(--ink-2);line-height:1.55;margin:0 0 16px">Kom je er niet uit? Thimo helpt je graag persoonlijk verder.</p>
          <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="ks-contact-card-btn">Stuur een bericht</a>
        </div>
      </div>

      <!-- Accordion content -->
      <div>

        <!-- BESTELLEN -->
        <div id="bestellen" class="ks-block open">
          <div class="ks-block-hdr">
            <div>
              <div class="eyebrow" style="margin-bottom:8px;color:var(--accent)">01</div>
              <h2 class="display" style="font-size:clamp(32px,4vw,52px);margin:0">Bestellen</h2>
            </div>
            <div class="ks-block-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>
          <div class="ks-block-body">
            <p style="font-size:16px;line-height:1.7;color:var(--ink-2);max-width:640px;margin:0 0 16px">
              Bestellingen kunnen worden opgegeven door gebruik te maken van ons <strong style="color:var(--ink)">online bestelsysteem</strong>. Zodra jouw bestelling is ontvangen wordt deze opgenomen in de orderadministratie en ontvang je een e-mail met daarop de bestelde producten, de prijzen per product en het totaalbedrag.
            </p>
            <div class="ks-callout">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
