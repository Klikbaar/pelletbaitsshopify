<style>
  .contact-hero {
    padding: 160px 0 80px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .contact-hero-inner { max-width: 720px; }
  .contact-hero-headline {
    font-size: clamp(64px, 10vw, 140px);
    margin: 0;
    color: var(--ink);
    line-height: .9;
  }
  .contact-hero-sub {
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
    font-weight: 300;
    max-width: 540px;
  }
  .contact-body {
    padding: 100px 0 120px;
    background: var(--bg);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: start;
  }
  .contact-info-block {
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
  }
  .contact-info-block:first-child { border-top: 1px solid var(--line); }
  .contact-info-label {
    font-size: 10px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .contact-info-value {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.2;
  }
  .contact-info-value a { color: var(--ink); transition: color var(--dur-fast) ease; }
  .contact-info-value a:hover { color: var(--accent); }
  .contact-info-note { margin-top: 6px; font-size: 13px; color: var(--ink-3); line-height: 1.5; }
  .contact-form-wrap {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 48px;
  }
  .contact-form-title {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .contact-form-intro {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: 36px;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cf-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
  .cf-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .cf-input, .cf-select, .cf-textarea {
    background: var(--bg-3);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    color: var(--ink);
    font-size: 14px;
    font-family: var(--font-body);
    outline: none;
    transition: border-color var(--dur-fast) ease;
    width: 100%;
  }
  .cf-input::placeholder, .cf-textarea::placeholder { color: var(--ink-3); }
  .cf-input:focus, .cf-select:focus, .cf-textarea:focus { border-color: var(--accent); }
  .cf-select { cursor: pointer; appearance: none; -webkit-appearance: none; }
  .cf-select option { background: var(--bg-2); }
  .cf-textarea { resize: vertical; min-height: 140px; line-height: 1.6; }
  .cf-submit {
    width: 100%;
    padding: 16px 24px;
    border-radius: 999px;
    background: var(--accent);
    color: #0a0f0e;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .16em;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    font-family: var(--font-body);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background var(--dur-fast) ease, transform var(--dur-fast) ease;
    margin-top: 8px;
  }
  .cf-submit:hover { background: var(--accent-2); color: #fff; transform: translateY(-2px); }
  .contact-usp-row {
    display: flex;
    gap: 48px;
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .contact-usp { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--ink-2); }
  .contact-usp svg { color: var(--accent); flex-shrink: 0; }
  .cf-success { background: rgba(99,207,5,.12); border: 1px solid rgba(99,207,5,.3); border-radius: var(--radius-sm); color: var(--accent); padding: 14px 16px; margin-bottom: 24px; font-size: 14px; }
  .cf-error   { background: rgba(196,90,28,.12); border: 1px solid rgba(196,90,28,.3); border-radius: var(--radius-sm); color: #e07048; padding: 14px 16px; margin-bottom: 24px; font-size: 14px; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 60px; }
    .contact-form-wrap { padding: 32px 24px; }
    .form-row { grid-template-columns: 1fr; }
    .contact-usp-row { gap: 28px; }
  }
  @media (max-width: 620px) {
    .contact-hero { padding: 120px 0 60px; }
  }
</style>

<!-- HERO -->
<section class="contact-hero">
  <div class="container">
    <div class="contact-hero-inner" data-anim="fade-up">
      <p class="eyebrow" style="margin-bottom:20px">Neem contact op</p>
      <h1 class="contact-hero-headline display">Heb je<br><span style="color:var(--accent)">een vraag?</span></h1>
      <p class="contact-hero-sub">Of je nu vragen hebt over ons assortiment, advies wil over de juiste pellets voor jouw vistechniek of een offerte wil aanvragen — wij staan voor je klaar.</p>
    </div>
  </div>
</section>

<!-- CONTACT BODY -->
<section class="contact-body">
  <div class="container">
    <div class="contact-grid">

      <!-- Contactinfo -->
      <div data-anim="slide-left">
        {%- if settings.email != blank -%}
          <div class="contact-info-block">
            <p class="contact-info-label">E-mail</p>
            <p class="contact-info-value"><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></p>
            <p class="contact-info-note">Reactie binnen 1 werkdag</p>
          </div>
        {%- endif -%}
        {%- if settings.phone != blank -%}
          <div class="contact-info-block">
            <p class="contact-info-label">Telefoon</p>
            <p class="contact-info-value"><a href="tel:{{ settings.phone | remove: ' ' | remove: '-' }}">{{ settings.phone }}</a></p>
            <p class="contact-info-note">Ma t/m vr · 09:00 – 17:00</p>
          </div>
        {%- endif -%}
        {%- if settings.address != blank -%}
          <div class="contact-info-block">
            <p class="contact-info-label">Adres</p>
            <p class="contact-info-value">{{ settings.address }}</p>
            <p class="contact-info-note">Bezoek alleen op afspraak</p>
          </div>
        {%- endif -%}
        <div class="contact-info-block">
          <p class="contact-info-label">KVK-nummer</p>
          <p class="contact-info-value">Pelletbaits B.V.</p>
          <p class="contact-info-note">Officieel Alltech Coppens distributeur</p>
        </div>
      </div>

      <!-- Formulier -->
      <div data-anim="slide-right">
        <div class="contact-form-wrap">
          <p class="contact-form-title">Stuur een bericht</p>
          <p class="contact-form-intro">Vul het formulier in en wij nemen zo snel mogelijk contact met je op. Heb je een specifieke vraag over een product of wil je een mix op maat? Vermeld dit dan in je bericht.</p>

          {%- form 'contact' -%}
            {%- if form.posted_successfully? -%}
              <p class="cf-success">Bedankt voor je bericht! We nemen zo snel mogelijk contact met je op.</p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="cf-error">Er is iets misgegaan. Controleer je gegevens en probeer het opnieuw.</p>
            {%- endif -%}

            <div class="form-row">
              <div class="cf-group">
                <label class="cf-label" for="cf-voornaam">Voornaam</label>
                <input class="cf-input" id="cf-voornaam" type="text" name="contact[first_name]" placeholder="Jouw voornaam" autocomplete="given-name" required>
              </div>
              <div class="cf-group">
                <label class="cf-label" for="cf-achternaam">Achternaam</label>
                <input class="cf-input" id="cf-achternaam" type="text" name="contact[last_name]" placeholder="Jouw achternaam" autocomplete="family-name" required>
              </div>
            </div>
            <div class="cf-group">
              <label class="cf-label" for="cf-email">E-mailadres</label>
              <input class="cf-input" id="cf-email" type="email" name="contact[email]" placeholder="jouw@email.nl" autocomplete="email" value="{{ form.email }}" required>
            </div>
            <div class="cf-group">
              <label class="cf-label" for="cf-telefoon">Telefoonnummer (optioneel)</label>
              <input class="cf-input" id="cf-telefoon" type="tel" name="contact[phone]" placeholder="06-12345678" autocomplete="tel">
            </div>
            <div class="cf-group">
              <label class="cf-label" for="cf-onderwerp">Onderwerp</label>
              <select class="cf-input cf-select" id="cf-onderwerp" name="contact[subject]" required>
                <option value="" disabled selected>Kies een onderwerp</option>
                <option>Productadvies</option>
                <option>Bestelling &amp; Bezorging</option>
                <option>Mix op maat</option>
                <option>Groothandel / Partnerschap</option>
                <option>Klacht of retour</option>
                <option>Overig</option>
              </select>
            </div>
            <div class="cf-group">
              <label class="cf-label" for="cf-bericht">Bericht</label>
              <textarea class="cf-textarea" id="cf-bericht" name="contact[body]" placeholder="Schrijf hier je vraag of bericht..." required>{{ form.body }}</textarea>
            </div>
            <button type="submit" class="cf-submit">
              Verstuur bericht
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          {%- endform -%}
        </div>

        <div class="contact-usp-row">
          <div class="contact-usp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Reactie binnen 1 werkdag
          </div>
          <div class="contact-usp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Persoonlijk advies
          </div>
          <div class="contact-usp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Mix op maat mogelijk
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact pagina",
  "settings": []
}
{% endschema %}
