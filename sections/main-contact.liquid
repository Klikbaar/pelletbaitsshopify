<section class="page-section section-pad">
  <div class="container container--narrow">
    <h1 class="page-title">{{ page.title | default: 'Contact' }}</h1>

    {%- if section.settings.intro != blank -%}
      <p class="page-intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="contact-layout">
      <div class="contact-form-wrap">
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success">Bedankt voor je bericht! We nemen zo snel mogelijk contact met je op.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="form-error">Er is iets misgegaan. Controleer je gegevens en probeer het opnieuw.</p>
          {%- endif -%}

          <div class="form-group">
            <label for="contact-name">Naam</label>
            <input id="contact-name" type="text" name="contact[name]" value="{{ form.name }}" required autocomplete="name">
          </div>

          <div class="form-group">
            <label for="contact-email">E-mailadres</label>
            <input id="contact-email" type="email" name="contact[email]" value="{{ form.email }}" required autocomplete="email">
          </div>

          <div class="form-group">
            <label for="contact-phone">Telefoonnummer <span class="form-optional">(optioneel)</span></label>
            <input id="contact-phone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>

          <div class="form-group">
            <label for="contact-message">Bericht</label>
            <textarea id="contact-message" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn btn--primary">Verstuur bericht</button>
        {%- endform -%}
      </div>

      <div class="contact-info">
        {%- if settings.email != blank -%}
          <div class="contact-info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:{{ settings.email }}">{{ settings.email }}</a>
          </div>
        {%- endif -%}
        {%- if settings.phone != blank -%}
          <div class="contact-info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
            <a href="tel:{{ settings.phone | remove: ' ' | remove: '-' }}">{{ settings.phone }}</a>
          </div>
        {%- endif -%}
        {%- if settings.whatsapp_number != blank -%}
          <div class="contact-info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">WhatsApp</a>
          </div>
        {%- endif -%}
        {%- if settings.address != blank -%}
          <div class="contact-info-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{{ settings.address }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact pagina",
  "settings": [
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro tekst",
      "default": "Heb je een vraag of wil je meer informatie? Vul het formulier in en we nemen zo snel mogelijk contact met je op."
    }
  ]
}
{% endschema %}
