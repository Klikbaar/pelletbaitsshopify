<style>
  /* === CLINICS PAGE === */

  /* Hero */
  .cl-hero { background: var(--bg-soft); padding: 40px 0 56px; }
  .cl-breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: .04em; color: var(--ink-3); margin-bottom: 20px; }
  .cl-breadcrumb a { color: inherit; }
  .cl-breadcrumb span.cur { color: var(--mid-green); font-weight: 600; }
  .cl-hero-img {
    position: relative; border-radius: 24px; overflow: hidden; min-height: 460px;
    background: repeating-linear-gradient(135deg, #16231d 0 16px, #1b2a22 16px 32px);
    display: flex; align-items: flex-end;
  }
  .cl-hero-img-inner { position: absolute; inset: 0; background-size: cover; background-position: center; filter: saturate(.85) brightness(.6); }
  .cl-hero-gradient { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,24,20,.15) 0%, rgba(14,24,20,.72) 100%); }
  .cl-hero-badge { position: absolute; top: 24px; left: 28px; display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.95); backdrop-filter: blur(8px); font-size: 12px; font-weight: 600; color: var(--deep-green); z-index: 2; }
  .cl-hero-badge-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--action); }
  .cl-hero-content { position: relative; z-index: 2; padding: 52px 56px 48px; max-width: 720px; color: #fff; }
  .cl-hero-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(44px, 6.5vw, 88px); letter-spacing: -.01em; line-height: .96; margin: 10px 0 0; text-transform: uppercase; text-shadow: 0 4px 30px rgba(0,0,0,.3); }
  .cl-hero-title span { color: var(--action); }
  .cl-hero-sub { margin-top: 20px; max-width: 540px; font-size: 17px; line-height: 1.55; color: rgba(255,255,255,.92); }
  .cl-hero-btns { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .cl-btn-primary { display: inline-flex; align-items: center; gap: 10px; padding: 16px 24px; border-radius: 999px; background: var(--action); color: #0e1814; font-weight: 700; font-size: 14px; letter-spacing: .02em; box-shadow: 0 14px 30px rgba(99,207,5,.4); text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .cl-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(99,207,5,.5); }
  .cl-btn-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 16px 22px; border-radius: 999px; background: rgba(255,255,255,.12); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 14px; text-decoration: none; transition: background .2s; }
  .cl-btn-ghost:hover { background: rgba(255,255,255,.2); }

  /* Stats strip */
  .cl-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 18px; }
  .cl-stat { padding: 20px 22px; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .cl-stat-n { font-family: var(--font-display); font-weight: 800; font-size: 38px; color: var(--mid-green); line-height: 1; }
  .cl-stat-t { font-size: 13px; color: var(--ink-2); margin-top: 6px; }

  /* Intro */
  .cl-intro { padding: 90px 0; background: #fff; }
  .cl-img-wrap { position: relative; }
  .cl-placeholder {
    aspect-ratio: 4/5; border-radius: 20px; overflow: hidden;
    background: repeating-linear-gradient(135deg, #eef0ea 0 14px, #f6f7f4 14px 28px);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px rgba(14,24,20,.12);
  }
  .cl-placeholder-label {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  }
  .cl-placeholder-label span {
    font-family: ui-monospace, monospace; font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ink-3); padding: 6px 12px; border: 1px dashed var(--ink-3); border-radius: 6px;
    background: rgba(255,255,255,.6);
  }
  .cl-stat-card {
    position: absolute; right: -20px; bottom: -30px; padding: 24px 26px;
    background: #fff; border-radius: 18px; border: 1px solid var(--line);
    box-shadow: 0 24px 50px rgba(14,24,20,.14); width: 240px;
  }
  .cl-stat-card-n { font-family: var(--font-display); font-size: 60px; font-weight: 800; color: var(--mid-green); line-height: .9; letter-spacing: -.02em; }
  .cl-stat-card-t { font-size: 13px; color: var(--ink-2); margin-top: 8px; line-height: 1.45; }
  .cl-intro-pts { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .cl-intro-pt { border-top: 1px solid var(--line-2); padding-top: 18px; }
  .cl-pt-check { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--action); color: #0e1814; margin-bottom: 14px; }
  .cl-pt-title { font-family: var(--font-display); font-size: 20px; font-weight: 700; color: var(--ink); letter-spacing: -.005em; }
  .cl-pt-desc { margin-top: 6px; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); }

  /* Clinic types */
  .cl-types { padding: 80px 0 30px; background: #fff; }
  .cl-types-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 36px; gap: 24px; flex-wrap: wrap; }
  .cl-btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px; border-radius: 999px; border: 1px solid var(--line-2); font-size: 13px; font-weight: 600; color: var(--ink); text-decoration: none; transition: border-color .2s, background .2s; }
  .cl-btn-outline:hover { border-color: var(--action); background: var(--bg-soft); }

  /* Steps */
  .cl-steps { padding: 80px 0; background: #fff; }
  .cl-steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 48px; }
  .cl-step { padding: 30px 26px; border: 1px solid var(--line); border-radius: 16px; background: var(--bg-soft); }
  .cl-step-n { font-family: var(--font-display); font-size: 48px; font-weight: 800; color: var(--action); line-height: 1; letter-spacing: -.02em; }
  .cl-step-t { font-family: var(--font-display); font-size: 22px; font-weight: 700; text-transform: uppercase; color: var(--ink); margin-top: 16px; }
  .cl-step-d { font-size: 13.5px; line-height: 1.55; color: var(--ink-2); margin-top: 10px; }

  /* Coaches */
  .cl-coaches { padding: 30px 0 80px; background: #fff; }
  .cl-coaches-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 32px; }
  .cl-coach { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; }
  .cl-coach-img {
    aspect-ratio: 4/3;
    background: repeating-linear-gradient(135deg, #eef0ea 0 14px, #f6f7f4 14px 28px);
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .cl-coach-body { padding: 20px 22px; }
  .cl-coach-name { font-family: var(--font-display); font-size: 24px; font-weight: 800; text-transform: uppercase; color: var(--ink); }
  .cl-coach-role { font-size: 12px; letter-spacing: .06em; color: var(--mid-green); font-weight: 600; margin-top: 4px; }
  .cl-coach-desc { font-size: 13.5px; line-height: 1.55; color: var(--ink-2); margin-top: 12px; }

  /* Contact CTA */
  .cl-contact { padding: 70px 0; background: var(--bg-soft); }
  .cl-contact-inner {
    position: relative; border-radius: 24px; overflow: hidden;
    background: linear-gradient(135deg, var(--deep-green) 0%, #0e1814 100%);
    padding: 56px; color: #fff;
  }
  .cl-contact-pattern { position: absolute; inset: 0; opacity: .14; background: repeating-linear-gradient(135deg, rgba(255,255,255,.07) 0 16px, transparent 16px 32px); }
  .cl-contact-grid { position: relative; display: grid; grid-template-columns: 1.3fr auto; gap: 40px; align-items: center; }
  .cl-contact-cta { display: flex; flex-direction: column; gap: 12px; min-width: 220px; }
  .cl-btn-action { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 16px 26px; border-radius: 999px; background: var(--action); color: #0e1814; font-weight: 700; font-size: 14px; letter-spacing: .02em; box-shadow: 0 14px 30px rgba(99,207,5,.3); text-decoration: none; transition: transform .2s; }
  .cl-btn-action:hover { transform: translateY(-2px); }
  .cl-btn-ghost-dark { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 26px; border-radius: 999px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.25); color: #fff; font-weight: 600; font-size: 14px; text-decoration: none; transition: background .2s; }
  .cl-btn-ghost-dark:hover { background: rgba(255,255,255,.18); }

  /* CTA banner (reuse global) */

  /* Responsive */
  @media (max-width: 1100px) {
    .cl-steps-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 980px) {
    .cl-stats { grid-template-columns: repeat(2, 1fr); }
    .cl-coaches-grid { grid-template-columns: 1fr 1fr; }
    .cl-intro-pts { grid-template-columns: 1fr; }
    .cl-stat-card { right: 12px; bottom: -20px; width: 200px; }
    .cl-contact-grid { grid-template-columns: 1fr; }
    .cl-contact-cta { flex-direction: row; flex-wrap: wrap; }
    .cl-hero-content { padding: 40px 28px 36px; }
  }
  @media (max-width: 720px) {
    .cl-stats { grid-template-columns: repeat(2, 1fr); }
    .cl-steps-grid { grid-template-columns: 1fr; }
    .cl-coaches-grid { grid-template-columns: 1fr; }
    .cl-hero-img { min-height: 340px; }
    .cl-hero-content { padding: 28px 20px 28px; }
    .cl-hero-title { font-size: clamp(38px, 10vw, 64px); }
  }
</style>

{%- liquid
  assign contact_url = pages['contact'].url | default: '/pages/contact'
-%}

<!-- HERO -->
<section class="cl-hero">
  <div class="pb-container">
    <div class="cl-breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>·</span>
      <span class="cur">Clinics</span>
    </div>

    <div class="cl-hero-img">
      {%- if section.settings.hero_image != blank -%}
        <div class="cl-hero-img-inner" style="background-image:url('{{ section.settings.hero_image | image_url: width: 1600 }}')"></div>
      {%- endif -%}
      <div class="cl-hero-gradient"></div>

      <div class="cl-hero-badge">
        <span class="cl-hero-badge-dot"></span>
        Nieuw · Seizoen 2026
      </div>

      <div class="cl-hero-content">
        <p class="pb-eyebrow" style="color:var(--action)">Leer van de besten</p>
        <h1 class="cl-hero-title">Pellet <span>clinics</span></h1>
        <p class="cl-hero-sub">{{ section.settings.hero_text }}</p>
        <div class="cl-hero-btns">
          <a href="#contact" class="cl-btn-primary">
            Plan een clinic
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#aanpak" class="cl-btn-ghost">Hoe het werkt</a>
        </div>
      </div>
    </div>

    <div class="cl-stats">
      <div class="cl-stat">
        <div class="cl-stat-n">120+</div>
        <div class="cl-stat-t">Deelnemers per seizoen</div>
      </div>
      <div class="cl-stat">
        <div class="cl-stat-n">4.9</div>
        <div class="cl-stat-t">Gemiddelde beoordeling</div>
      </div>
      <div class="cl-stat">
        <div class="cl-stat-n">8</div>
        <div class="cl-stat-t">Locaties door heel NL</div>
      </div>
      <div class="cl-stat">
        <div class="cl-stat-n">2</div>
        <div class="cl-stat-t">Coaches per clinic</div>
      </div>
    </div>
  </div>
</section>

<!-- INTRO / AANPAK -->
<section id="aanpak" class="cl-intro">
  <div class="pb-container">
    <div class="pb-feat-grid">
      <div class="cl-img-wrap">
        <div class="cl-placeholder">
          {%- if section.settings.intro_image != blank -%}
            <img src="{{ section.settings.intro_image | image_url: width: 800 }}" alt="Clinic sfeerfoto" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
          {%- else -%}
            <div class="cl-placeholder-label"><span>clinic sfeerfoto</span></div>
          {%- endif -%}
        </div>
        <div class="cl-stat-card">
          <div class="cl-stat-card-n">1-op-1</div>
          <div class="cl-stat-card-t">Persoonlijke begeleiding aan de waterkant door ervaren coaches.</div>
        </div>
      </div>

      <div>
        <p class="pb-eyebrow">Onze aanpak</p>
        <h2 class="pb-display" style="font-size:clamp(36px,5vw,64px);margin:8px 0 0;color:var(--ink)">
          {{ section.settings.intro_heading | default: 'Leer meer.' }}<br>
          <span style="color:var(--mid-green)">{{ section.settings.intro_heading_accent | default: 'Vang meer.' }}</span>
        </h2>
        <p style="margin-top:22px;max-width:520px;font-size:16px;line-height:1.6;color:var(--ink-2)">
          {{ section.settings.intro_text }}
        </p>
        <div class="cl-intro-pts">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature_point' -%}
              <div class="cl-intro-pt" {{ block.shopify_attributes }}>
                <div class="cl-pt-check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="cl-pt-title">{{ block.settings.title }}</div>
                <div class="cl-pt-desc">{{ block.settings.description }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CLINIC TYPES -->
<section id="types" class="cl-types">
  <div class="pb-container">
    <div class="cl-types-head">
      <div>
        <p class="pb-eyebrow">Het aanbod</p>
        <h2 class="pb-display" style="font-size:clamp(36px,4.5vw,56px);margin:8px 0 0;color:var(--ink)">
          Kies je <span style="color:var(--mid-green)">clinic</span>
        </h2>
      </div>
      <a href="#contact" class="cl-btn-outline">
        Plan een clinic
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="pb-cats-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'clinic_type' -%}
          <a href="#contact" class="pb-cat-card{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
            <div class="pb-cat-img" style="
              {%- if block.settings.image != blank -%}
                background-image:url('{{ block.settings.image | image_url: width: 900 }}');
              {%- else -%}
                background:repeating-linear-gradient(135deg, #16231d 0 14px, #21342a 14px 28px);
              {%- endif -%}
            "></div>
            <div class="pb-cat-overlay"></div>
            <span class="pb-cat-tag">vanaf €{{ block.settings.price }}</span>
            <div class="pb-cat-body">
              <div style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.85);font-weight:600">{{ block.settings.level }} · {{ block.settings.duration }}</div>
              <span class="pb-cat-title">{{ block.settings.title }}</span>
              <span class="pb-cat-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- HOE HET WERKT -->
<section class="cl-steps">
  <div class="pb-container">
    <div style="text-align:center">
      <p class="pb-eyebrow">In 4 stappen</p>
      <h2 class="pb-display" style="font-size:clamp(36px,4.5vw,56px);margin:8px 0 0;color:var(--ink)">
        Hoe een clinic <span style="color:var(--mid-green)">werkt</span>
      </h2>
    </div>
    <div class="cl-steps-grid">
      <div class="cl-step">
        <div class="cl-step-n">01</div>
        <div class="cl-step-t">Kies &amp; boek</div>
        <p class="cl-step-d">Kies het type clinic dat bij jouw niveau past en neem contact op. Wij plannen samen een datum en locatie.</p>
      </div>
      <div class="cl-step">
        <div class="cl-step-n">02</div>
        <div class="cl-step-t">Wij regelen alles</div>
        <p class="cl-step-d">Van materiaal tot locatie — wij zorgen dat alles klaarstaat zodat jij je kunt focussen op vissen.</p>
      </div>
      <div class="cl-step">
        <div class="cl-step-n">03</div>
        <div class="cl-step-t">Leer aan het water</div>
        <p class="cl-step-d">Hands-on begeleiding door onze coaches. Praktisch, direct toepasbaar en altijd op jouw tempo.</p>
      </div>
      <div class="cl-step">
        <div class="cl-step-n">04</div>
        <div class="cl-step-t">Vang die topvis</div>
        <p class="cl-step-d">Met de nieuwe kennis en technieken ga je zelfverzekerd op pad. Resultaat gegarandeerd.</p>
      </div>
    </div>
  </div>
</section>

<!-- COACHES -->
<section class="cl-coaches">
  <div class="pb-container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
      <div>
        <p class="pb-eyebrow">Het team</p>
        <h2 class="pb-display" style="font-size:clamp(36px,4.5vw,56px);margin:8px 0 0;color:var(--ink)">
          Je <span style="color:var(--mid-green)">coaches</span>
        </h2>
      </div>
    </div>
    <div class="cl-coaches-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'coach' -%}
          <div class="cl-coach" {{ block.shopify_attributes }}>
            <div class="cl-coach-img">
              {%- if block.settings.photo != blank -%}
                <img src="{{ block.settings.photo | image_url: width: 600 }}" alt="{{ block.settings.name }}" style="width:100%;height:100%;object-fit:cover;">
              {%- else -%}
                <div class="cl-placeholder-label"><span>coach portret</span></div>
              {%- endif -%}
            </div>
            <div class="cl-coach-body">
              <div class="cl-coach-name">{{ block.settings.name }}</div>
              <div class="cl-coach-role">{{ block.settings.role }}</div>
              <p class="cl-coach-desc">{{ block.settings.bio }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- CONTACT CTA -->
<section id="contact" class="cl-contact">
  <div class="pb-container">
    <div class="cl-contact-inner">
      <div class="cl-contact-pattern"></div>
      <div class="cl-contact-grid">
        <div>
          <p class="pb-eyebrow" style="color:var(--action)">Maak een afspraak</p>
          <h2 class="pb-display" style="font-size:clamp(34px,4.5vw,56px);margin:12px 0 0;color:#fff">
            Klaar voor je<br><span style="color:var(--action)">eigen clinic?</span>
          </h2>
          <p style="margin-top:18px;max-width:520px;font-size:16px;line-height:1.6;color:rgba(255,255,255,.85)">
            {{ section.settings.contact_text | default: 'Plan eenvoudig een datum en locatie via onze contactpagina — wij nemen snel contact met je op.' }}
          </p>
        </div>
        <div class="cl-contact-cta">
          <a href="{{ contact_url }}" class="cl-btn-action">
            Naar contactpagina
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="{{ contact_url }}" class="cl-btn-ghost-dark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 17v3a2 2 0 0 1-2.2 2A19 19 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L7.9 9.7a16 16 0 0 0 6.4 6.4l1.3-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6A2 2 0 0 1 22 17z"/></svg>
            Neem contact op
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA BANNER -->
{%- if section.settings.show_cta -%}
<section class="pb-cta-section" style="padding:90px 0;background:var(--deep-green);position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;opacity:.08;background:repeating-linear-gradient(135deg,rgba(255,255,255,.15) 0 20px,transparent 20px 40px)"></div>
  <div class="pb-container" style="position:relative;text-align:center">
    <p class="pb-eyebrow" style="color:var(--action)">Klaar om te beginnen?</p>
    <h2 class="pb-display" style="font-size:clamp(44px,6vw,80px);margin:10px 0 0;color:#fff">
      {{ section.settings.cta_heading | default: 'Vang die mega karper!' }}
    </h2>
    <p style="margin:20px auto 0;max-width:540px;font-size:17px;line-height:1.6;color:rgba(255,255,255,.8)">
      {{ section.settings.cta_text | default: 'Schrijf je in voor een clinic en leer van de beste coaches.' }}
    </p>
    <div style="display:flex;gap:12px;justify-content:center;margin-top:32px;flex-wrap:wrap">
      <a href="#contact" class="cl-btn-primary">{{ section.settings.cta_label | default: 'Plan een clinic' }}</a>
      <a href="{{ routes.collections_url }}" class="cl-btn-ghost">Bekijk de shop</a>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Clinics pagina",
  "settings": [
