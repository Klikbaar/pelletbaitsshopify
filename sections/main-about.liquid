<style>
  .oo-quote-grid { display: grid; grid-template-columns: 120px 1fr; gap: 40px; align-items: flex-start; max-width: 1100px; margin: 0 auto; }
  .oo-story-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; align-items: center; }
  .oo-founder-stat { position: absolute; bottom: -30px; right: -20px; padding: 24px; border-radius: 14px; background: var(--bg-3); border: 1px solid var(--line-2); width: 240px; box-shadow: 0 24px 60px rgba(0,0,0,.5); }
  .oo-tl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--line-2); }
  .oo-assort-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 80px; align-items: center; }
  .oo-value-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .oo-value-card-offset { margin-top: 32px; }

  @media (max-width: 900px) {
    .oo-quote-grid { grid-template-columns: 1fr; gap: 20px; }
    .oo-story-grid { grid-template-columns: 1fr; gap: 60px; }
    .oo-founder-stat { position: relative; bottom: auto; right: auto; width: auto; margin-top: 20px; }
    .oo-assort-grid { grid-template-columns: 1fr; gap: 60px; }
    .oo-tl-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .oo-value-grid { grid-template-columns: 1fr; }
    .oo-value-card-offset { margin-top: 0; }
    .oo-tl-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- HERO -->
<section style="position:relative;min-height:78vh;overflow:hidden;background:#000">
  <div style="position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1534673611236-b6bc9007f1f8?auto=format&fit=crop&w=2400&q=80');background-size:cover;background-position:center;filter:saturate(.85) brightness(.6);transform:scale(1.05)"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,15,14,.5) 0%,rgba(10,15,14,.2) 35%,rgba(10,15,14,.85) 100%)"></div>
  {%- if settings.logo != blank -%}
    {{ settings.logo | image_url: height: 110 | image_tag: style: 'position:absolute;bottom:36px;right:40px;height:110px;width:auto;opacity:.55;z-index:2;pointer-events:none;', alt: shop.name }}
  {%- endif -%}
  <div class="container" style="position:relative;z-index:2;padding-top:24vh;padding-bottom:80px">
    <div style="display:flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.7);margin-bottom:18px" data-anim="fade-up">
      <a href="{{ routes.root_url }}" style="color:inherit">Home</a>
      <span>·</span>
      <span style="color:#fff">Over Ons</span>
    </div>
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px" data-anim="fade-up" data-anim-delay="80">
      <span style="width:32px;height:1px;background:var(--accent)"></span>
      <span class="eyebrow" style="color:#fff">Sinds 2018 · Familiebedrijf</span>
    </div>
    <h1 class="display" style="font-size:clamp(64px,11vw,180px);margin:0;color:#fff;padding-bottom:.12em;text-shadow:0 4px 30px rgba(0,0,0,.4)" data-anim="fade-up" data-anim-delay="160">
      Visbloed<br><span style="color:var(--gold)">in de aderen.</span>
    </h1>
    <p style="margin-top:28px;max-width:560px;font-size:17px;line-height:1.55;color:rgba(255,255,255,.78);font-weight:300" data-anim="fade-up" data-anim-delay="280">
      Het verhaal van Timo van der Vaart en Pellet Baits — van vader-zoon aan de waterkant tot een complete pelletvisserij-specialist.
    </p>
  </div>
</section>

<!-- INTRO QUOTE -->
<section style="padding:120px 0 80px;background:var(--bg)">
  <div class="container">
    <div class="oo-quote-grid" data-anim="fade-up">
      <div class="num" style="padding-top:14px">01 / Verhaal</div>
      <div>
        <p style="font-family:var(--font-display);font-weight:600;font-size:clamp(28px,3.4vw,46px);line-height:1.15;margin:0;color:var(--ink);text-transform:none;letter-spacing:-.005em">
          "Al van jongs af aan stroomt het visbloed door mijn aderen. Als klein jongetje met pa mee vissen, daarna zelf op onderzoek uit. Prachtige visreizen gemaakt en mooie vissen gevangen."
        </p>
        <p style="margin-top:24px;font-size:16px;line-height:1.65;color:var(--ink-2);max-width:640px;font-weight:300">
          En wat is er dan niet mooier om van je grootste hobby uiteindelijk werk te kunnen maken!
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FOUNDER + STORY -->
<section style="padding:80px 0 120px;background:var(--bg)">
  <div class="container">
    <div class="oo-story-grid">
      <div style="position:relative" data-anim="slide-left">
        <div style="position:relative;aspect-ratio:4/5;border-radius:18px;overflow:hidden">
          <img src="{{ 'thimo.jpg' | asset_url }}" style="width:100%;height:100%;object-fit:cover;object-position:center top" alt="Timo van der Vaart, oprichter Pellet Baits" loading="lazy">
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(10,15,14,.6))"></div>
          <div style="position:absolute;top:24px;left:24px;padding:8px 14px;border-radius:999px;background:rgba(0,0,0,.5);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.15);font-size:11px;letter-spacing:.2em;text-transform:uppercase">Oprichter · Timo</div>
          <div style="position:absolute;bottom:24px;left:24px;right:24px;color:#fff">
            <div class="display" style="font-size:36px">Timo van der Vaart</div>
            <div style="font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.7);margin-top:6px">Founder · Visser sinds altijd</div>
          </div>
        </div>
        <div class="oo-founder-stat">
          <div class="display" style="font-size:64px;color:var(--accent);line-height:1">2018</div>
          <div style="font-size:12px;color:var(--ink-2);margin-top:8px;line-height:1.5">Het jaar dat Pellet Baits werd opgericht — gespecialiseerd in pelletvisserij.</div>
        </div>
      </div>
      <div data-anim="slide-right">
        <div class="eyebrow" style="margin-bottom:16px">Hoe het begon</div>
        <h2 class="display" style="font-size:clamp(40px,5.2vw,76px);margin:0;color:var(--ink);padding-bottom:.06em">
          Van koi-voer<br><span style="color:var(--accent)">naar pelletvisserij.</span>
        </h2>
        <div style="margin-top:28px;display:grid;gap:20px;font-size:16px;line-height:1.7;color:var(--ink-2);font-weight:300;max-width:560px">
          <p style="margin:0">
            Januari 2017 heb ik samen met mijn vrouw een bedrijfje overgenomen in <strong style="color:var(--ink);font-weight:500">koi, vijver- en aquariumvoer</strong>. Onze leverancier <strong style="color:var(--ink);font-weight:500">Coppens</strong> heeft een fantastisch en zeer uitgebreid assortiment aan pellets voor de hengelsport.
          </p>
          <p style="margin:0">
            Vandaar dat wij in 2018 met <strong style="color:var(--ink);font-weight:500">Pellet Baits</strong> zijn gestart — een bedrijf dat volledig gespecialiseerd is op de pelletvisserij. Karperpellets, meervalpellets, pellets voor method feeder of de pellet waggler. Je kunt het zo gek niet bedenken. Pellet Baits heeft alles in huis.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TIMELINE -->
<section style="padding:120px 0;background:var(--bg-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:24px;margin-bottom:60px">
      <div>
        <div class="eyebrow" style="margin-bottom:16px">De Reis</div>
        <h2 class="display" style="font-size:clamp(40px,5vw,72px);margin:0">Van waterkant tot webshop.</h2>
      </div>
      <div class="num">02 / Tijdlijn</div>
    </div>
    <div class="oo-tl-grid">
      <div style="padding:32px 24px 24px;border-right:1px solid var(--line)" data-anim="fade-up">
        <div class="display" style="font-size:48px;color:var(--gold)">'90s</div>
        <div class="display" style="font-size:18px;margin-top:14px">De Eerste Hengel</div>
        <p style="font-size:13px;line-height:1.6;color:var(--ink-2);margin-top:10px">Met pa naar de waterkant. Onderzoek doen, fouten maken, leren.</p>
      </div>
      <div style="padding:32px 24px 24px;border-right:1px solid var(--line)" data-anim="fade-up" data-anim-delay="120">
        <div class="display" style="font-size:48px;color:var(--gold)">2017</div>
        <div class="display" style="font-size:18px;margin-top:14px">Koi &amp; Vijver</div>
        <p style="font-size:13px;line-height:1.6;color:var(--ink-2);margin-top:10px">Bedrijf overgenomen samen met mijn vrouw. Eerste kennismaking met Coppens.</p>
      </div>
      <div style="padding:32px 24px 24px;border-right:1px solid var(--line)" data-anim="fade-up" data-anim-delay="240">
        <div class="display" style="font-size:48px;color:var(--accent)">2018</div>
        <div class="display" style="font-size:18px;margin-top:14px">Pellet Baits</div>
        <p style="font-size:13px;line-height:1.6;color:var(--ink-2);margin-top:10px">Volledig gespecialiseerd op de pelletvisserij. Hobby werd werk.</p>
      </div>
      <div style="padding:32px 24px 24px" data-anim="fade-up" data-anim-delay="360">
        <div class="display" style="font-size:48px;color:var(--gold)">Nu</div>
        <div class="display" style="font-size:18px;margin-top:14px">Compleet &amp; Op Maat</div>
        <p style="font-size:13px;line-height:1.6;color:var(--ink-2);margin-top:10px">Compleet Coppens-assortiment plus mixen op maat van de klant.</p>
      </div>
    </div>
  </div>
</section>

<!-- ASSORTIMENT / WAARDEN -->
<section style="padding:140px 0;background:var(--bg)">
  <div class="container">
    <div class="oo-assort-grid">
      <div data-anim="slide-left">
        <div class="eyebrow" style="margin-bottom:16px">Het Assortiment</div>
        <h2 class="display" style="font-size:clamp(40px,5.4vw,80px);margin:0;color:var(--ink);padding-bottom:.06em">
          Het complete<br><span style="color:var(--gold)">Coppens-assortiment.</span>
        </h2>
        <p style="margin-top:24px;max-width:520px;font-size:16px;line-height:1.65;color:var(--ink-2);font-weight:300">
          Pellet Baits biedt het complete assortiment van Coppens aan, inclusief alle beschikbare maten. Zit jouw wens wat betreft mix niet in ons assortiment? Dan kan je ons altijd contacten en stellen we jouw mix naar jouw wens samen. Klantgerichtheid staat hoog in het vaandel.
        </p>
        <div style="margin-top:36px;display:grid;gap:0;border-top:1px solid var(--line-2)">
          <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)">
            <span style="font-size:14px">Karperpellets</span>
            <span class="num">+24 varianten</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)">
            <span style="font-size:14px">Meervalpellets</span>
            <span class="num">+8 varianten</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)">
            <span style="font-size:14px">Method feeder pellets</span>
            <span class="num">+12 varianten</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)">
            <span style="font-size:14px">Pellet waggler</span>
            <span class="num">+6 varianten</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)">
            <span style="font-size:14px;color:var(--accent);font-weight:600">Mix op maat</span>
            <span class="num" style="color:var(--accent)">Op aanvraag →</span>
          </div>
        </div>
        <a href="{{ routes.collections_url }}" style="display:inline-flex;align-items:center;gap:12px;margin-top:32px;padding:16px 26px;border-radius:999px;background:var(--accent);color:#fff;font-weight:600;font-size:13px;letter-spacing:.16em;text-transform:uppercase;box-shadow:0 14px 40px rgba(99,207,5,.25)">
          Bekijk de shop
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="oo-value-grid">
        <div style="padding:28px 22px;border:1px solid var(--line);border-radius:14px;background:var(--bg-2)" data-anim="fade-up">
          <div style="width:42px;height:42px;border-radius:50%;border:1px solid var(--line-2);display:inline-flex;align-items:center;justify-content:center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6l8-3z"/></svg>
          </div>
          <div class="display" style="font-size:22px;margin-top:18px">Coppens-Officieel</div>
          <p style="font-size:13px;line-height:1.55;color:var(--ink-2);margin-top:10px">Direct van de fabrikant — alle maten, alle varianten.</p>
        </div>
        <div class="oo-value-card-offset" style="padding:28px 22px;border:1px solid var(--line);border-radius:14px;background:var(--bg-2)" data-anim="fade-up" data-anim-delay="120">
          <div style="width:42px;height:42px;border-radius:50%;border:1px solid var(--line-2);display:inline-flex;align-items:center;justify-content:center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3c4 5 7 8 7 12a7 7 0 1 1-14 0c0-4 3-7 7-12z"/></svg>
          </div>
          <div class="display" style="font-size:22px;margin-top:18px">Mix op Maat</div>
          <p style="font-size:13px;line-height:1.55;color:var(--ink-2);margin-top:10px">Wens niet in het assortiment? We stellen je mix samen.</p>
        </div>
        <div style="padding:28px 22px;border:1px solid var(--line);border-radius:14px;background:var(--bg-2)" data-anim="fade-up" data-anim-delay="80">
          <div style="width:42px;height:42px;border-radius:50%;border:1px solid var(--line-2);display:inline-flex;align-items:center;justify-content:center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 12c3-4 7-5 11-5 3 0 5 1 7 3-2 3-5 4-7 4-4 0-8-1-11-2z"/><circle cx="16" cy="11" r=".6" fill="currentColor"/></svg>
          </div>
          <div class="display" style="font-size:22px;margin-top:18px">Klant Voorop</div>
          <p style="font-size:13px;line-height:1.55;color:var(--ink-2);margin-top:10px">Klantgerichtheid staat hoog in het vaandel. Persoonlijk contact.</p>
        </div>
        <div class="oo-value-card-offset" style="padding:28px 22px;border:1px solid var(--line);border-radius:14px;background:var(--bg-2)" data-anim="fade-up" data-anim-delay="200">
          <div style="width:42px;height:42px;border-radius:50%;border:1px solid var(--line-2);display:inline-flex;align-items:center;justify-content:center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="9" r="2.5"/><circle cx="15" cy="13" r="2.5"/><circle cx="10" cy="16" r="1.5"/></svg>
          </div>
          <div class="display" style="font-size:22px;margin-top:18px">Alle Maten</div>
          <p style="font-size:13px;line-height:1.55;color:var(--ink-2);margin-top:10px">Van proefverpakking tot bulk — kies wat past bij jouw sessie.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SIGNATURE / CONTACT -->
<section style="padding:140px 0;background:var(--bg)">
  <div class="container">
    <div style="max-width:980px;margin:0 auto;text-align:center">
      <div class="eyebrow" style="margin-bottom:24px" data-anim="fade-up">Tot Snel</div>
      <h2 class="display" style="font-size:clamp(48px,7vw,120px);margin:0;color:var(--ink);padding-bottom:.06em" data-anim="fade-up" data-anim-delay="80">
        We hopen je als<br>klant te mogen <span style="color:var(--accent)">verwelkomen.</span>
      </h2>
      <div style="display:inline-flex;flex-direction:column;align-items:center;margin-top:60px;padding:32px 48px;border-top:1px solid var(--line-2);border-bottom:1px solid var(--line-2)" data-anim="scale-in" data-anim-delay="200">
        <div style="font-family:var(--font-display);font-style:italic;font-weight:500;font-size:36px;color:var(--gold);letter-spacing:.02em;transform:rotate(-2deg)">~ Timo</div>
        <div style="font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-3);margin-top:14px">Timo van der Vaart · Oprichter Pellet Baits</div>
      </div>
      <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;margin-top:48px" data-anim="fade-up" data-anim-delay="320">
        {%- if settings.email != blank -%}
          <a href="mailto:{{ settings.email }}" style="display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border-radius:999px;border:1px solid var(--line-2);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            {{ settings.email }}
          </a>
        {%- endif -%}
        {%- if settings.phone != blank -%}
          <a href="tel:{{ settings.phone | remove: ' ' | remove: '-' }}" style="display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border-radius:999px;border:1px solid var(--line-2);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
            Bel direct
          </a>
        {%- endif -%}
        <a href="{{ routes.collections_url }}" style="display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border-radius:999px;background:var(--inv-bg);color:var(--inv-color);font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase">
          Naar de shop
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Over ons",
  "settings": []
}
{% endschema %}
