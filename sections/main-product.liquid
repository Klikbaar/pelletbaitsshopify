{%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign product_form_id = 'product-form-' | append: section.id -%}

  <div class="product-page">
    <div class="container">

      <nav class="product-breadcrumb" aria-label="Broodkruimel">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span aria-hidden="true">&rsaquo;</span>
        {%- endif -%}
        <span>{{ product.title }}</span>
      </nav>

      <div class="product-layout">

        <!-- Gallery -->
        <div class="product-gallery">
          <div class="product-image-main">
            {%- if product.featured_image != blank -%}
 <img src="{{ product.featured_image | image_url: width: 800 }}"
       id="featured-image"
       class="product-main-img"
       alt="{{ product.featured_image.alt | default: product.title | escape }}"
       loading="eager"
       width="800" height="800"
            {%- else -%}
              <div class="product-image-placeholder">
                <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="m21 15-5-5L5 21"/>
                </svg>
              </div>
            {%- endif -%}
          </div>

          {%- if product.images.size > 1 -%}
            <div class="product-image-thumbs">
              {%- for image in product.images limit: 5 -%}
                <button class="product-thumb{% if forloop.first %} active{% endif %}"
                  data-image-url="{{ image | image_url: width: 800 }}"
                  data-image-alt="{{ image.alt | default: product.title | escape }}"
                  aria-label="{{ image.alt | default: product.title | escape }}">
                  {{ image | image_url: width: 100 | image_tag: loading: 'lazy', alt: image.alt | default: product.title
   }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <!-- Product info -->
        <div class="product-info">
          <p class="product-category-tag">{{ product.type }}</p>
          <h1 class="product-title">{{ product.title }}</h1>

          {%- if product.description != blank -%}
            <div class="product-short-desc">{{ product.description | strip_html | truncate: 220 }}</div>
          {%- endif -%}

          <div class="product-price-row">
            <span class="product-price" id="product-price">
              {%- if current_variant.compare_at_price > current_variant.price -%}
                <span class="price-sale">{{ current_variant.price | money }}</span>
                <span class="price-compare">{{ current_variant.compare_at_price | money }}</span>
              {%- else -%}
                {{ current_variant.price | money }}
              {%- endif -%}
            </span>
          </div>

          {%- form 'product', product, id: product_form_id -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" id="variant-id-input">

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="variant-block">
                  <p class="variant-label">
                    {{ option.name }}: <strong id="selected-{{ option.name | handleize }}">{{ option.selected_value
  }}</strong>
                  </p>
                  <div class="variant-pills" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name |
   handleize }}">
                    {%- for value in option.values -%}
                      <button type="button"
                        class="variant-pill{% if option.selected_value == value %} active{% endif %}"
                        data-value="{{ value | escape }}"
                        data-option="{{ option.name | handleize }}">
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <div class="atc-row">
              <div class="qty-control">
                <button type="button" class="qty-btn" data-qty="minus" aria-label="Minder">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="2"><path d="M5 12h14"/></svg>
                </button>
                <input class="qty-input" type="number" name="quantity" value="1" min="1" aria-label="Aantal">
                <button type="button" class="qty-btn" data-qty="plus" aria-label="Meer">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                </button>
              </div>
              <button type="submit" name="add" class="btn-atc" id="add-to-cart-btn"
                {%- unless current_variant.available -%} disabled{%- endunless -%}>
                {%- if current_variant.available -%}Toevoegen aan winkelwagen{%- else -%}Uitverkocht{%- endif -%}
              </button>
            </div>
          {%- endform -%}

          <div class="product-assurance">
            <div class="assurance-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)"
  stroke-width="1.6"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 20a2 2 0 1 0 0-4 2 2
  0 0 0 0 4z"/></svg>
              <span>Voor 23:00 besteld — morgen in huis</span>
            </div>
            <div class="assurance-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)"
  stroke-width="1.6"><path d="M3 7l9-4 9 4-9 4-9-4zM3 7v10l9 4 9-4V7"/></svg>
              <span>14 dagen retour</span>
            </div>
            <div class="assurance-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)"
  stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Veilig betalen</span>
            </div>
          </div>

          <div class="product-tabs">
            <div class="tab-nav" role="tablist">
              <button class="tab-btn active" role="tab" data-tab="tab-description"
  aria-selected="true">Omschrijving</button>
              <button class="tab-btn" role="tab" data-tab="tab-details" aria-selected="false">Details</button>
              <button class="tab-btn" role="tab" data-tab="tab-shipping" aria-selected="false">Verzending</button>
            </div>
            <div class="tab-panel active" id="tab-description" role="tabpanel">
              {{ product.description }}
            </div>
            <div class="tab-panel" id="tab-details" role="tabpanel">
              <table class="spec-table">
                <thead><tr><th>Eigenschap</th><th>Waarde</th></tr></thead>
                <tbody>
                  {%- if product.type != blank -%}
                    <tr><td>Type</td><td>{{ product.type }}</td></tr>
                  {%- endif -%}
                  {%- if product.vendor != blank -%}
                    <tr><td>Merk</td><td>{{ product.vendor }}</td></tr>
                  {%- endif -%}
                  {%- for option in product.options_with_values -%}
                    <tr><td>{{ option.name }}</td><td>{{ option.values | join: ', ' }}</td></tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            <div class="tab-panel" id="tab-shipping" role="tabpanel">
              <p>Gratis verzending vanaf €45. Bestellingen voor 23:00 worden de volgende werkdag geleverd. Retour is
  mogelijk binnen 14 dagen na ontvangst.</p>
            </div>
          </div>
        </div>
      </div>

      {%- if section.settings.show_related -%}
        {%- assign related_collection = collections[product.collections.first.handle] -%}
        {%- if related_collection != blank and related_collection.products_count > 1 -%}
          <div style="margin-top:100px;">
            <h2 class="display" style="font-size:clamp(36px,4vw,56px);color:var(--accent);margin-bottom:32px;">Vissers
  kochten ook</h2>
            <div class="product-grid-3" role="list">
              {%- for related_product in related_collection.products limit: 4 -%}
                {%- unless related_product.id == product.id -%}
                  <div role="listitem">{% render 'product-card', product: related_product %}</div>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>

  <script>
  (function() {
    var productVariants = {{ product.variants | json }};
    var productOptions  = {{ product.options | json }};
    var selectedOptions = [
      {%- for option in product.options_with_values -%}
        "{{ option.selected_value | escape }}"{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ];

    function findVariant() {
      return productVariants.find(function(v) {
        return selectedOptions.every(function(val, i) {
          return v['option' + (i + 1)] === val;
        });
      });
    }

    function updateUI(variant) {
      if (!variant) return;
      document.getElementById('variant-id-input').value = variant.id;

      var priceEl = document.getElementById('product-price');
      if (priceEl) {
        if (variant.compare_at_price > variant.price) {
          priceEl.innerHTML =
            '<span class="price-sale">' + formatMoney(variant.price) + '</span>' +
            '<span class="price-compare">' + formatMoney(variant.compare_at_price) + '</span>';
        } else {
          priceEl.textContent = formatMoney(variant.price);
        }
      }

      var btn = document.getElementById('add-to-cart-btn');
      if (btn) {
        btn.disabled = !variant.available;
        btn.textContent = variant.available ? 'Toevoegen aan winkelwagen' : 'Uitverkocht';
      }

      var url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());
    }

    function formatMoney(cents) {
      return new Intl.NumberFormat('nl-NL', {
        style: 'currency',
        currency: '{{ shop.currency }}'
      }).format(cents / 100);
    }

    document.querySelectorAll('.variant-pill').forEach(function(pill) {
      pill.addEventListener('click', function() {
        var optionIndex = parseInt(pill.closest('[data-option-index]').dataset.optionIndex, 10);
        selectedOptions[optionIndex] = pill.dataset.value;

        pill.closest('[data-option-name]').querySelectorAll('.variant-pill').forEach(function(p) {
          p.classList.remove('active');
        });
        pill.classList.add('active');

        var labelId = 'selected-' + pill.dataset.option;
        var label = document.getElementById(labelId);
        if (label) label.textContent = pill.dataset.value;

        updateUI(findVariant());
      });
    });

    document.querySelectorAll('.product-thumb').forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        document.querySelectorAll('.product-thumb').forEach(function(t) { t.classList.remove('active'); });
        thumb.classList.add('active');
        var img = document.getElementById('featured-image');
        if (img) { img.src = thumb.dataset.imageUrl; img.alt = thumb.dataset.imageAlt; }
      });
    });

    var form = document.getElementById('{{ product_form_id }}');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var btn = document.getElementById('add-to-cart-btn');
        var variantId = document.getElementById('variant-id-input').value;
        var qtyInput = form.querySelector('.qty-input');
        btn.disabled = true;
        btn.textContent = 'Wordt toegevoegd…';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(variantId, 10), quantity: qtyInput ? parseInt(qtyInput.value, 10) : 1 })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          btn.textContent = 'Toegevoegd!';
          if (typeof window.pbUpdateCart === 'function') window.pbUpdateCart();
          if (typeof window.pbOpenCart === 'function') window.pbOpenCart();
          setTimeout(function() {
            btn.disabled = false;
            btn.textContent = 'Toevoegen aan winkelwagen';
          }, 2000);
        })
        .catch(function() {
          btn.disabled = false;
          btn.textContent = 'Probeer opnieuw';
        });
      });
    }
  })();
  </script>

  {% schema %}
  {
    "name": "Product",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_related",
        "label": "Toon gerelateerde producten",
        "default": true
      }
    ]
  }
  {% endschema %}