<style>
  /* === ZAKELIJK PAGE === */

  /* Hero */
  .zk-hero { background: var(--bg-soft); padding: 40px 0 56px; }
  .zk-breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: .04em; color: var(--ink-3); margin-bottom: 20px; }
  .zk-breadcrumb a { color: inherit; }
  .zk-breadcrumb span.cur { color: var(--mid-green); font-weight: 600; }
  .zk-hero-img {
    position: relative; border-radius: 24px; overflow: hidden; min-height: 440px;
    background: repeating-linear-gradient(135deg, #16231d 0 16px, #1b2a22 16px 32px);
    display: flex; align-items: flex-end;
  }
  .zk-hero-img-inner { position: absolute; inset: 0; background-size: cover; background-position: center; filter: saturate(.85) brightness(.6); }
  .zk-hero-gradient { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,24,20,.15) 0%, rgba(14,24,20,.72) 100%); }
  .zk-hero-badge { position: absolute; top: 24px; left: 28px; display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.95); backdrop-filter: blur(8px); font-size: 12px; font-weight: 600; color: var(--deep-green); z-index: 2; }
  .zk-hero-badge-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--action); }
  .zk-hero-content { position: relative; z-index: 2; padding: 52px 56px 48px; max-width: 720px; color: #fff; }
  .zk-hero-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(44px,6.5vw,88px); letter-spacing: -.01em; line-height: .96; margin: 10px 0 0; text-transform: uppercase; text-shadow: 0 4px 30px rgba(0,0,0,.3); }
  .zk-hero-title span { color: var(--action); }
  .zk-hero-sub { margin-top: 20px; max-width: 540px; font-size: 17px; line-height: 1.55; color: rgba(255,255,255,.92); }
  .zk-hero-btns { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .zk-btn-primary { display: inline-flex; align-items: center; gap: 10px; padding: 16px 24px; border-radius: 999px; background: var(--action); color: #0e1814; font-weight: 700; font-size: 14px; letter-spacing: .02em; box-shadow: 0 14px 30px rgba(99,207,5,.4); text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .zk-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(99,207,5,.5); }
  .zk-btn-ghost { display: inline-flex; align-items: center; gap: 10px; padding: 16px 22px; border-radius: 999px; background: rgba(255,255,255,.12); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,.3); color: #fff; font-weight: 600; font-size: 14px; text-decoration: none; transition: background .2s; }
  .zk-btn-ghost:hover { background: rgba(255,255,255,.2); }

  /* Stats strip */
  .zk-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 18px; }
  .zk-stat { padding: 20px 22px; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .zk-stat-n { font-family: var(--font-display); font-weight: 800; font-size: 38px; color: var(--mid-green); line-height: 1; }
  .zk-stat-t { font-size: 13px; color: var(--ink-2); margin-top: 6px; }

  /* Intro */
  .zk-intro { padding: 90px 0; background: #fff; }
  .zk-placeholder {
    aspect-ratio: 4/5; border-radius: 20px; overflow: hidden;
    background: repeating-linear-gradient(135deg, #eef0ea 0 14px, #f6f7f4 14px 28px);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px rgba(14,24,20,.12);
    position: relative;
  }
  .zk-placeholder-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .zk-placeholder-label span { font-family: ui-monospace, monospace; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); padding: 6px 12px; border: 1px dashed var(--ink-3); border-radius: 6px; background: rgba(255,255,255,.6); }
  .zk-stat-card {
    position: absolute; right: -20px; bottom: -30px; padding: 24px 26px;
    background: #fff; border-radius: 18px; border: 1px solid var(--line);
    box-shadow: 0 24px 50px rgba(14,24,20,.14); width: 240px;
  }
  .zk-stat-card-n { font-family: var(--font-display); font-size: 60px; font-weight: 800; color: var(--mid-green); line-height: .9; letter-spacing: -.02em; }
  .zk-stat-card-t { font-size: 13px; color: var(--ink-2); margin-top: 8px; line-height: 1.45; }
  .zk-intro-pts { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .zk-intro-pt { border-top: 1px solid var(--line-2); padding-top: 18px; }
  .zk-pt-check { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--action); color: #0e1814; margin-bottom: 14px; }
  .zk-pt-title { font-family: var(--font-display); font-size: 20px; font-weight: 700; color: var(--ink); letter-spacing: -.005em; }
  .zk-pt-desc { margin-top: 6px; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); }

  /* Services */
  .zk-services { padding: 80px 0; background: var(--bg-soft); }
  .zk-services-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 36px; gap: 24px; flex-wrap: wrap; }
  .zk-serv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .zk-serv-card { padding: 28px 26px; background: #fff; border: 1px solid var(--line); border-radius: 16px; }
  .zk-serv-icon { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; border-radius: 50%; background: #f4f6f1; color: var(--deep-green); }
  .zk-serv-title { font-family: var(--font-display); font-size: 22px; font-weight: 700; text-transform: uppercase; color: var(--ink); margin-top: 18px; }
  .zk-serv-desc { font-size: 13.5px; line-height: 1.55; color: var(--ink-2); margin-top: 10px; }

  /* Contact CTA */
  .zk-contact { padding: 70px 0; background: #fff; }
  .zk-contact-inner {
    position: relative; border-radius: 24px; overflow: hidden;
    background: linear-gradient(135deg, var(--deep-green) 0%, #0e1814 100%);
    padding: 56px; color: #fff;
  }
  .zk-contact-pattern { position: absolute; inset: 0; opacity: .14; background: repeating-linear-gradient(135deg, rgba(255,255,255,.07) 0 16px, transparent 16px 32px); }
  .zk-contact-grid { position: relative; display: grid; grid-template-columns: 1.3fr auto; gap: 40px; align-items: center; }
  .zk-contact-cta { display: flex; flex-direction: column; gap: 12px; min-width: 220px; }
  .zk-btn-action { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 16px 26px; border-radius: 999px; background: var(--action); color: #0e1814; font-weight: 700; font-size: 14px; letter-spacing: .02em; box-shadow: 0 14px 30px rgba(99,207,5,.3); text-decoration: none; transition: transform .2s; }
  .zk-btn-action:hover { transform: translateY(-2px); }
  .zk-btn-ghost-dark { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 26px; border-radius: 999px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.25); color: #fff; font-weight: 600; font-size: 14px; text-decoration: none; transition: background .2s; }
  .zk-btn-ghost-dark:hover { background: rgba(255,255,255,.18); }

  /* Responsive */
  @media (max-width: 1100px) {
    .zk-serv-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 980px) {
    .zk-stats { grid-template-columns: repeat(2,1fr); }
    .zk-intro-pts { grid-template-columns: 1fr; }
    .zk-stat-card { right: 12px; bottom: -20px; width: 200px; }
    .zk-contact-grid { grid-template-columns: 1fr; }
    .zk-contact-cta { flex-direction: row; flex-wrap: wrap; }
    .zk-hero-content { padding: 40px 28px 36px; }
  }
  @media (max-width: 720px) {
    .zk-stats { grid-template-columns: repeat(2,1fr); }
    .zk-serv-grid { grid-template-columns: 1fr; }
    .zk-hero-img { min-height: 340px; }
    .zk-hero-content { padding: 28px 20px 28px; }
    .zk-hero-title { font-size: clamp(38px,10vw,64px); }
  }
</style>

{%- liquid
  assign contact_url = pages['contact'].url | default: '/pages/contact'
-%}

<!-- HERO -->
<section class="zk-hero">
  <div class="pb-container">
    <div class="zk-breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>·</span>
      <span class="cur">Zakelijk</span>
    </div>

    <div class="zk-hero-img">
      {%- if section.settings.hero_image != blank -%}
        <div class="zk-hero-img-inner" style="background-image:url('{{ section.settings.hero_image | image_url: width: 1600 }}')"></div>
      {%- endif -%}
      <div class="zk-hero-gradient"></div>

      <div class="zk-hero-badge">
        <span class="zk-hero-badge-dot"></span>
        Trade &amp; wederverkoop
      </div>

      <div class="zk-hero-content">
        <p class="pb-eyebrow" style="color:var(--action)">Voor bedrijven</p>
        <h1 class="zk-hero-title">Zakelijk <span>partner</span></h1>
        <p class="zk-hero-sub">{{ section.settings.hero_text }}</p>
        <div class="zk-hero-btns">
          <a href="#contact" class="zk-btn-primary">
            Word partner
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#diensten" class="zk-btn-ghost">Onze diensten</a>
        </div>
      </div>
    </div>

    <div class="zk-stats">
      <div class="zk-stat">
        <div class="zk-stat-n">250+</div>
        <div class="zk-stat-t">Zakelijke klanten</div>
      </div>
      <div class="zk-stat">
        <div class="zk-stat-n">24u</div>
        <div class="zk-stat-t">Levering op voorraad</div>
      </div>
      <div class="zk-stat">
        <div class="zk-stat-n">-30%</div>
        <div class="zk-stat-t">Staffelkorting mogelijk</div>
      </div>
      <div class="zk-stat">
        <div class="zk-stat-n">1</div>
        <div class="zk-stat-t">Vaste accountmanager</div>
      </div>
    </div>
  </div>
</section>

<!-- INTRO / WAAROM -->
<section class="zk-intro">
  <div class="pb-container">
    <div class="pb-feat-grid">
      <div style="position:relative">
        <div class="zk-placeholder">
          {%- if section.settings.intro_image != blank -%}
            <img src="{{ section.settings.intro_image | image_url: width: 800 }}" alt="Zakelijk sfeerfoto" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
          {%- else -%}
            <div class="zk-placeholder-label"><span>magazijn / voorraad</span></div>
          {%- endif -%}
        </div>
        <div class="zk-stat-card">
          <div class="zk-stat-card-n">B2B</div>
          <div class="zk-stat-card-t">Scherpe inkoopprijzen en persoonlijke service voor wederverkopers.</div>
        </div>
      </div>

      <div>
        <p class="pb-eyebrow">Waarom Pellet Baits</p>
        <h2 class="pb-display" style="font-size:clamp(36px,5vw,64px);margin:8px 0 0;color:var(--ink)">
          {{ section.settings.intro_heading | default: 'Samen groeien.' }}<br>
          <span style="color:var(--mid-green)">{{ section.settings.intro_heading_accent | default: 'Samen winnen.' }}</span>
        </h2>
        <p style="margin-top:22px;max-width:520px;font-size:16px;line-height:1.6;color:var(--ink-2)">
          {{ section.settings.intro_text }}
        </p>
        <div class="zk-intro-pts">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature_point' -%}
              <div class="zk-intro-pt" {{ block.shopify_attributes }}>
                <div class="zk-pt-check">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="zk-pt-title">{{ block.settings.title }}</div>
                <div class="zk-pt-desc">{{ block.settings.description }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- DIENSTEN -->
<section id="diensten" class="zk-services">
  <div class="pb-container">
    <div class="zk-services-head">
      <div>
        <p class="pb-eyebrow">Wat we bieden</p>
        <h2 class="pb-display" style="font-size:clamp(36px,4.5vw,56px);margin:8px 0 0;color:var(--ink)">
          Onze <span style="color:var(--mid-green)">diensten</span>
        </h2>
      </div>
      <p style="font-size:13px;color:var(--ink-2);max-width:320px;line-height:1.5;margin:0">{{ section.settings.services_text }}</p>
    </div>
    <div class="zk-serv-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'service' -%}
          <div class="zk-serv-card" {{ block.shopify_attributes }}>
            <span class="zk-serv-icon">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/></svg>
                {%- when 'award' -%}
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M9 13.5L7 21l5-3 5 3-2-7.5"/></svg>
                {%- when 'shield' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- when 'phone' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M22 17v3a2 2 0 0 1-2.2 2A19 19 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L7.9 9.7a16 16 0 0 0 6.4 6.4l1.3-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6A2 2 0 0 1 22 17z"/></svg>
                {%- when 'calendar' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                {%- else -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {%- endcase -%}
            </span>
            <div class="zk-serv-title">{{ block.settings.title }}</div>
            <p class="zk-serv-desc">{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- CONTACT CTA -->
<section id="contact" class="zk-contact">
  <div class="pb-container">
    <div class="zk-contact-inner">
      <div class="zk-contact-pattern"></div>
      <div class="zk-contact-grid">
        <div>
          <p class="pb-eyebrow" style="color:var(--action)">Partner worden</p>
          <h2 class="pb-display" style="font-size:clamp(34px,4.5vw,56px);margin:12px 0 0;color:#fff">
            Samen <span style="color:var(--action)">zakendoen?</span>
          </h2>
          <p style="margin-top:18px;max-width:520px;font-size:16px;line-height:1.6;color:rgba(255,255,255,.85)">
            {{ section.settings.contact_text | default: 'Vraag vrijblijvend een zakelijke offerte aan via onze contactpagina — wij nemen snel contact met je op.' }}
          </p>
        </div>
        <div class="zk-contact-cta">
          <a href="{{ contact_url }}" class="zk-btn-action">
            Naar contactpagina
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="{{ contact_url }}" class="zk-btn-ghost-dark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 17v3a2 2 0 0 1-2.2 2A19 19 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L7.9 9.7a16 16 0 0 0 6.4 6.4l1.3-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6A2 2 0 0 1 22 17z"/></svg>
            Neem contact op
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA BANNER -->
{%- if section.settings.show_cta -%}
<section style="padding:90px 0;background:var(--deep-green);position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;opacity:.08;background:repeating-linear-gradient(135deg,rgba(255,255,255,.15) 0 20px,transparent 20px 40px)"></div>
  <div class="pb-container" style="position:relative;text-align:center">
    <p class="pb-eyebrow" style="color:var(--action)">Klaar om te beginnen?</p>
    <h2 class="pb-display" style="font-size:clamp(44px,6vw,80px);margin:10px 0 0;color:#fff">
      {{ section.settings.cta_heading | default: 'Zakelijk samenwerken?' }}
    </h2>
    <p style="margin:20px auto 0;max-width:540px;font-size:17px;line-height:1.6;color:rgba(255,255,255,.8)">
      {{ section.settings.cta_text | default: 'Neem contact op en ontdek wat we voor jouw bedrijf kunnen betekenen.' }}
    </p>
    <div style="display:flex;gap:12px;justify-content:center;margin-top:32px;flex-wrap:wrap">
      <a href="{{ contact_url }}" class="zk-btn-primary">{{ section.settings.cta_label | default: 'Word partner' }}</a>
      <a href="{{ routes.collections_url }}" class="zk-btn-ghost">Bekijk de shop</a>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Zakelijk pagina",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero achtergrondafbeelding"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero subtekst",
      "default": "Als officieel Alltech Coppens distributeur bieden wij wederverkopers, hengelsportzaken en grootgebruikers scherpe inkoopprijzen, vaste leverdagen en persoonlijke begeleiding."
    },
    {
      "type": "header",
      "content": "Intro sectie"
    },
    {
      "type": "image_picker",
      "id": "intro_image",
      "label": "Intro sfeerfoto (magazijn / voorraad)"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Intro koptekst",
      "default": "Samen groeien."
    },
    {
      "type": "text",
      "id": "intro_heading_accent",
      "label": "Koptekst accent (groen)",
      "default": "Samen winnen."
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro tekst",
      "default": "Al meer dan 250 zakelijke klanten gingen je voor. Van kleine hengelsportzaken tot grote watersportcentra — Pellet Baits is dé betrouwbare partner voor wie kwaliteitsvispellets inkoopt."
    },
    {
      "type": "header",
      "content": "Diensten sectie"
    },
    {
      "type": "textarea",
      "id": "services_text",
      "label": "Korte tekst naast de koptekst",
      "default": "Van wederverkoop en private label tot bulk­orders en maatwerk — we denken graag met u mee."
    },
    {
      "type": "header",
      "content": "Contact banner"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact tekst",
      "default": "Vraag vrijblijvend een zakelijke offerte aan via onze contactpagina — wij nemen snel contact met je op."
    },
    {
      "type": "header",
      "content": "CTA banner"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "CTA banner tonen",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA koptekst",
      "default": "Zakelijk samenwerken?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA tekst",
      "default": "Neem contact op en ontdek wat we voor jouw bedrijf kunnen betekenen."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA knoptekst",
      "default": "Word partner"
    }
  ],
  "blocks": [
    {
      "type": "feature_point",
      "name": "Voordeel punt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Scherpe inkoopprijzen" },
        { "type": "textarea", "id": "description", "label": "Omschrijving", "default": "Staffelkortingen van 10 tot 30% afhankelijk van volume en frequentie." }
      ]
    },
    {
      "type": "service",
      "name": "Dienst",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            { "value": "truck",    "label": "Vrachtwagen (levering)" },
            { "value": "award",    "label": "Award (kwaliteit)" },
            { "value": "shield",   "label": "Schild (zekerheid)" },
            { "value": "phone",    "label": "Telefoon (contact)" },
            { "value": "calendar", "label": "Kalender (leverdagen)" },
            { "value": "check",    "label": "Vinkje (maatwerk)" }
          ],
