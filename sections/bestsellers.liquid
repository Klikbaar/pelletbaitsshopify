<section class="best-sellers" id="bestsellers" aria-labelledby="bestsellers-heading">
  <div class="pb-container">
    <div class="section-header-row" data-anim="fade-up">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="pb-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="pb-display bs-headline" id="bestsellers-heading" style="font-size:clamp(36px,4.5vw,56px);margin:8px 0 0">
          {{ section.settings.heading_prefix }}<span style="color:var(--mid-green)">{{ section.settings.heading_accent }}</span>
        </h2>
      </div>
      <a href="{{ routes.collections_url }}" class="btn-view-all">
        Alle {{ section.settings.total_count | default: '156' }} producten
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pb-prod-grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- assign product = all_products[block.settings.product] -%}
            <div role="listitem" data-anim="fade-up" data-anim-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
              {% render 'product-card', product: product %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color:var(--ink-3);text-align:center;padding:40px 0;">
        Voeg producten toe via de thema-editor.
      </p>
    {%- endif -%}

    <div class="bs-view-all">
      <a href="{{ routes.collections_url }}" class="btn-view-all" style="padding:14px 26px;font-size:14px">
        Bekijk alle producten
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Onze hardlopers"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Koptekst prefix",
      "default": "Best"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Koptekst accent",
      "default": "sellers"
    },
    {
      "type": "text",
      "id": "total_count",
      "label": "Totaal aantal producten (voor knoptekst)",
      "default": "156"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Bestsellers" }]
}
{% endschema %}
