<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">

      <div>
        <div class="footer-logo-wrap">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 200 | image_tag: class: 'footer-logo-img', alt: shop.name }}
          {%- else -%}
            <span class="footer-logo-text">{{ shop.name | upcase }}</span>
          {%- endif -%}
        </div>
        <p class="footer-desc">{{ section.settings.description }}</p>
        <div class="footer-contact" style="margin-top:20px;display:flex;flex-direction:column;gap:8px;font-size:13px;color:var(--ink-3);">
          {%- if settings.email != blank -%}
            <a href="mailto:{{ settings.email }}" style="transition:color .14s ease;">{{ settings.email }}</a>
          {%- endif -%}
          {%- if settings.phone != blank -%}
            <a href="tel:{{ settings.phone | remove: ' ' | remove: '-' }}" style="transition:color .14s ease;">{{ settings.phone }}</a>
          {%- endif -%}
          {%- if settings.address != blank -%}
            <span>{{ settings.address }}</span>
          {%- endif -%}
        </div>
      </div>

      <div>
        <p class="footer-col-title eyebrow">{{ section.settings.cat_title }}</p>
        <ul class="footer-links">
          {%- if linklists[section.settings.cat_menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.cat_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/karpervissen">Karpervissen</a></li>
            <li><a href="/collections/meervalvissen">Meervalvissen</a></li>
            <li><a href="/collections/steurvissen">Steurvissen</a></li>
            <li><a href="/collections/methodfeeder">Methodfeeder</a></li>
            <li><a href="/collections/waggler">Waggler</a></li>
            <li><a href="/collections/koi-vijver">Koi/Vijver</a></li>
            <li><a href="/collections/tools-merchandise">Tools &amp; Merchandise</a></li>
          {%- endif -%}
        </ul>
      </div>

      <div>
        <p class="footer-col-title eyebrow">{{ section.settings.info_title }}</p>
        <ul class="footer-links">
          {%- for link in linklists[section.settings.info_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
          {%- assign info_has_over_ons = false -%}
          {%- assign info_has_contact = false -%}
          {%- for link in linklists[section.settings.info_menu].links -%}
            {%- if link.title == 'Over ons' or link.title == 'Over Ons' -%}{%- assign info_has_over_ons = true -%}{%- endif -%}
            {%- if link.title == 'Contact' or link.title == 'contact' -%}{%- assign info_has_contact = true -%}{%- endif -%}
          {%- endfor -%}
          {%- unless info_has_over_ons -%}
            {%- if pages['over-ons'] -%}
              <li><a href="{{ pages['over-ons'].url }}">Over ons</a></li>
            {%- else -%}
              <li><a href="/pages/over-ons">Over ons</a></li>
            {%- endif -%}
          {%- endunless -%}
          {%- unless info_has_contact -%}
            {%- if pages['contact'] -%}
              <li><a href="{{ pages['contact'].url }}">Contact</a></li>
            {%- else -%}
              <li><a href="/pages/contact">Contact</a></li>
            {%- endif -%}
          {%- endunless -%}
        </ul>
      </div>

      <div>
        <p class="footer-col-title eyebrow">Nieuwsbrief</p>
        <p class="footer-newsletter-body">{{ section.settings.newsletter_text }}</p>
        <form method="post" action="/contact" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="&#x2713;">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form">
            <label class="visually-hidden" for="newsletter-email">E-mailadres</label>
            <input class="newsletter-input" id="newsletter-email" type="email" name="contact[email]" placeholder="jouw@email.nl" autocomplete="email" required>
            <button class="newsletter-submit" type="submit">OK</button>
          </div>
        </form>
        <p class="newsletter-note">Door je aan te melden ga je akkoord met onze <a href="#">privacyverklaring</a>.</p>
      </div>

    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle rechten voorbehouden.</p>
      <div class="footer-bottom-links">
        {%- for link in linklists[section.settings.legal_menu].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Omschrijving",
      "default": "De specialist in vispellets. Officieel distributeur van Alltech Coppens."
    },
    {
      "type": "text",
      "id": "cat_title",
      "label": "Kolomtitel categorieen",
      "default": "Categorieen"
    },
    {
      "type": "link_list",
      "id": "cat_menu",
      "label": "Categorieen menu"
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Kolomtitel informatie",
      "default": "Informatie"
    },
    {
      "type": "link_list",
      "id": "info_menu",
      "label": "Informatie menu"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Juridisch menu"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Nieuwsbrief tekst",
      "default": "Blijf op de hoogte van aanbiedingen bij Pellet Baits!"
    }
  ]
}
{% endschema %}
