<style>
  .collection-hero { padding: 56px 0 40px; border-bottom: 1px solid var(--line); }
  .collection-hero-breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 18px; }
  .collection-hero-breadcrumb a { color: var(--ink-3); transition: color var(--dur-fast) ease; }
  .collection-hero-breadcrumb a:hover { color: var(--accent); }
  .collection-hero-inner { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .collection-hero-title { font-size: clamp(56px, 7vw, 108px); margin: 0; padding-bottom: .12em; }
  .collection-hero-desc { margin-top: 20px; max-width: 560px; font-size: 15px; line-height: 1.6; color: var(--ink-2); font-weight: 300; }

  .collection-body { padding: 40px 0 80px; }
  .collection-layout { display: grid; grid-template-columns: 240px 1fr; gap: 40px; }

  /* Sidebar */
  .col-sidebar { position: sticky; top: 90px; align-self: start; height: fit-content; }
  .col-sidebar-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .col-sidebar-title { display: flex; align-items: center; gap: 8px; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; }
  .col-sidebar-reset { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); }
  .col-filter-group { border-bottom: 1px solid var(--line); padding: 20px 0; }
  .col-filter-label { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink); font-weight: 600; margin-bottom: 14px; display: block; }
  .col-filter-tags { display: grid; gap: 10px; }
  .col-filter-tag { display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: var(--ink-2); text-decoration: none; transition: color var(--dur-fast) ease; }
  .col-filter-tag:hover, .col-filter-tag.active { color: var(--ink); }
  .col-filter-tag.active::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 8px; flex-shrink: 0; }

  /* Toolbar */
  .col-toolbar { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 20px; flex-wrap: wrap; gap: 14px; }
  .col-toolbar-count { font-size: 13px; color: var(--ink-2); }
  .col-sort { background: var(--bg-3); color: var(--ink); border: 1px solid var(--line-2); border-radius: 6px; padding: 8px 28px 8px 12px; font-size: 13px; font-family: var(--font-body); appearance: none; -webkit-appearance: none; cursor: pointer; outline: none; }
  .col-sort:focus { border-color: var(--accent); }

  @media (max-width: 900px) { .collection-layout { grid-template-columns: 1fr; } .col-sidebar { position: static; } }
  @media (max-width: 600px) { .collection-hero { padding: 100px 0 32px; } }
</style>

<!-- HERO -->
<section class="collection-hero">
  <div class="container">
    <nav class="collection-hero-breadcrumb" aria-label="Broodkruimel">
      <a href="{{ routes.root_url }}">Home</a>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      <a href="{{ routes.collections_url }}">Shop</a>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      <span style="color:var(--ink)">{{ collection.title }}</span>
    </nav>
    <div class="collection-hero-inner">
      <div style="max-width:760px">
        <p class="eyebrow" style="margin-bottom:10px">Categorie</p>
        <h1 class="display collection-hero-title">
          {{ collection.title | split: ' ' | first }}
          <span style="color:var(--gold)"> {{ collection.title | split: ' ' | slice: 1, 10 | join: ' ' }}</span>
        </h1>
        {%- if collection.description != blank -%}
          <p class="collection-hero-desc">{{ collection.description }}</p>
        {%- endif -%}
      </div>
      <div style="text-align:right">
        <div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-3);">{{ collection.products_count }} producten</div>
      </div>
    </div>
  </div>
</section>

<!-- BODY -->
<section class="collection-body">
  <div class="container">
    <div class="collection-layout">

      <!-- SIDEBAR -->
      <aside class="col-sidebar">
        <div class="col-sidebar-header">
          <span class="col-sidebar-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h18M6 12h12M10 18h4"/></svg>
            Filters
          </span>
          <a href="{{ collection.url }}" class="col-sidebar-reset">Reset</a>
        </div>

        {%- if collection.filters.size > 0 -%}
          {%- for filter in collection.filters -%}
            <div class="col-filter-group">
              <span class="col-filter-label">{{ filter.label }}</span>
              <div class="col-filter-tags">
                {%- for filter_value in filter.values -%}
                  <a href="{{ filter_value.url_to_add }}"
                     class="col-filter-tag{% if filter_value.active %} active{% endif %}">
                    <span>{{ filter_value.label }}</span>
                    <span style="font-size:11px;color:var(--ink-3)">{{ filter_value.count }}</span>
                  </a>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- assign tag_groups = 'Diameter,Verpakking,Eigenschap' | split: ',' -%}
          <div class="col-filter-group">
            <span class="col-filter-label">Tags</span>
            <div class="col-filter-tags">
              {%- for tag in collection.all_tags limit: 12 -%}
                {%- assign tag_active = false -%}
                {%- for current_tag in current_tags -%}
                  {%- if current_tag == tag -%}{%- assign tag_active = true -%}{%- endif -%}
                {%- endfor -%}
                <a href="{{ collection.url }}/{{ tag | handle }}"
                   class="col-filter-tag{% if tag_active %} active{% endif %}">
                  <span>{{ tag }}</span>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </aside>

      <!-- MAIN -->
      <div>
        {%- paginate collection.products by section.settings.products_per_page -%}

          <!-- TOOLBAR -->
          <div class="col-toolbar">
            <span class="col-toolbar-count">{{ collection.products_count }} resultaten</span>
            {%- if section.settings.show_sort -%}
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              <select class="col-sort" id="sort-by" aria-label="Sorteren op">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            {%- endif -%}
          </div>

          {%- if collection.products.size == 0 -%}
            <p style="text-align:center;padding:80px 0;color:var(--ink-2);">
              Geen producten gevonden in deze categorie.
            </p>
          {%- else -%}
            <div class="product-grid-3" role="list">
              {%- for product in collection.products -%}
                <div role="listitem" data-anim="fade-up" data-anim-delay="{{ forloop.index0 | times: 60 }}">
                  {% render 'product-card', product: product %}
                </div>
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="pagination" aria-label="Paginering" style="display:flex;justify-content:center;align-items:center;gap:6px;margin-top:48px;">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="nav-arrow-btn" aria-label="Vorige pagina">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                  </a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="nav-arrow-btn">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span class="nav-arrow-btn filled" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span style="padding:0 8px;color:var(--ink-3);">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="nav-arrow-btn" aria-label="Volgende pagina">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- endif -%}

        {%- endpaginate -%}
      </div>

    </div>
  </div>
</section>

<script>
  document.getElementById('sort-by')?.addEventListener('change', function() {
    var url = new URL(window.location.href);
    url.searchParams.set('sort_by', this.value);
    window.location.href = url.toString();
  });
</script>

{% schema %}
{
  "name": "Productoverzicht",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Producten per pagina",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Toon sorteeropties",
      "default": true
    }
  ]
}
{% endschema %}
