<section class="categories-section" id="categories" aria-labelledby="cat-heading">
  <div class="container">
    <div class="section-header-row" data-anim="fade-up">
      <div>
        <p class="eyebrow" style="margin-bottom:16px">{{ section.settings.eyebrow }}</p>
        <h2 class="cat-headline display" id="cat-heading">
          {{ section.settings.heading }} <span style="color:var(--accent)">{{ section.settings.heading_accent }}</span>
        </h2>
      </div>
    </div>
    <div class="cat-grid">
      <nav class="cat-list" aria-label="Categorieën">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <a href="{{ block.settings.url }}"
               class="cat-item{% if forloop.first %} active{% endif %}"
               data-cat="cat-{{ forloop.index }}"
               data-anim="fade-up"
               data-anim-delay="{{ forloop.index0 | times: 60 }}"
               {{ block.shopify_attributes }}>
              <span class="cat-item-icon num">0{{ forloop.index }}</span>
              <div>
                <p class="cat-item-name">{{ block.settings.title }}</p>
                {%- if block.settings.collection != blank -%}
                  {%- assign cat_col = collections[block.settings.collection] -%}
                  <div class="cat-item-meta"><span>{{ cat_col.products_count }} producten</span></div>
                {%- endif -%}
              </div>
              <span class="cat-item-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="cat-image-panel" aria-hidden="true" data-anim="fade-in" data-anim-delay="160">
        <div class="cat-image-wrap">
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag:
                  class: forloop.first | map: 'active' | join: ' ',
                  data-cat: 'cat-' | append: forloop.index,
                  alt: block.settings.title,
                  loading: 'lazy'
                }}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <div class="cat-image-overlay"></div>
          <div class="cat-image-label">
            <p class="eyebrow">Categorie</p>
            <p class="cat-image-label-name">{{ section.blocks.first.settings.title }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorieën",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Assortiment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Koptekst",
      "default": "Shop per"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Koptekst accent",
      "default": "vismethodes"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Karpervissen"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collectie (voor productaantal)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Categorieën",
      "blocks": [
        { "type": "category", "settings": { "title": "Karpervissen" } },
        { "type": "category", "settings": { "title": "Meervalvissen" } },
        { "type": "category", "settings": { "title": "Steurvissen" } },
        { "type": "category", "settings": { "title": "Methodfeeder" } },
        { "type": "category", "settings": { "title": "Waggler" } },
        { "type": "category", "settings": { "title": "Koi/Vijver" } },
        { "type": "category", "settings": { "title": "Tools & Merchandise" } }
      ]
    }
  ]
}
{% endschema %}
