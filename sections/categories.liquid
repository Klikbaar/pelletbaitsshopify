<section class="categories-section" id="categorieen" aria-labelledby="cat-heading">
  <div class="pb-container">
    <div class="section-header-row" data-anim="fade-up">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="pb-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="pb-display" id="cat-heading" style="font-size:clamp(32px,4.5vw,52px);margin:8px 0 0;color:var(--ink)">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}
            <span style="color:var(--mid-green)">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h2>
      </div>
      <a href="{{ routes.collections_url }}" class="btn-view-all">
        Bekijk alle categorieën
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="pb-cats-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- liquid
            assign cat_href = block.settings.url
            if cat_href == blank and block.settings.collection != blank
              assign cat_href = collections[block.settings.collection].url
            endif
            if cat_href == blank
              assign cat_href = routes.collections_url
            endif
            assign cat_count = ''
            if block.settings.collection != blank
              assign cat_col = collections[block.settings.collection]
              assign cat_count = cat_col.products_count | append: ' producten'
            elsif block.settings.count_text != blank
              assign cat_count = block.settings.count_text
            endif
            assign is_featured = block.settings.featured
          -%}

          <a href="{{ cat_href }}"
             class="pb-cat-card{% if is_featured %} is-featured{% endif %}"
             data-anim="scale-in"
             data-anim-delay="{{ forloop.index0 | times: 60 }}"
             {{ block.shopify_attributes }}>

            <div class="pb-cat-img" style="background-image:url('
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 }}
              {%- else -%}
                https://images.unsplash.com/photo-1545486332-9e0999c535b2?auto=format&fit=crop&w=900&q=75
              {%- endif -%}
            ')" aria-hidden="true"></div>
            <div class="pb-cat-overlay" aria-hidden="true"></div>

            {%- if block.settings.tag != blank -%}
              <span class="pb-cat-tag">{{ block.settings.tag }}</span>
            {%- endif -%}

            <div class="pb-cat-body">
              {%- if cat_count != '' -%}
                <span class="pb-cat-count">{{ cat_count }}</span>
              {%- endif -%}
              <span class="pb-cat-title">{{ block.settings.title }}</span>
              <span class="pb-cat-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorieën",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Assortiment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Koptekst",
      "default": "Shop per "
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Koptekst accent",
      "default": "vismethode"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categorie",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Karpervissen"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collectie (voor productaantal)"
        },
        {
          "type": "text",
          "id": "count_text",
          "label": "Aantal tekst (als geen collectie)",
          "placeholder": "42 producten"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge label (optioneel)",
          "placeholder": "Nieuw"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Uitgelicht (donkerder overlay)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Categorieën",
      "blocks": [
        { "type": "category", "settings": { "title": "Karpervissen", "count_text": "42 producten" } },
        { "type": "category", "settings": { "title": "Meervalvissen", "count_text": "18 producten" } },
        { "type": "category", "settings": { "title": "Steurvissen", "count_text": "12 producten" } },
        { "type": "category", "settings": { "title": "Method Feeder", "count_text": "24 producten" } },
        { "type": "category", "settings": { "title": "Waggler", "count_text": "16 producten" } },
        { "type": "category", "settings": { "title": "Koi · Vijver", "count_text": "9 producten" } },
        { "type": "category", "settings": { "title": "Tools & Merchandise", "count_text": "28 producten" } },
        { "type": "category", "settings": { "title": "Clinics", "count_text": "Boek je sessie", "tag": "Nieuw", "featured": true } },
        { "type": "category", "settings": { "title": "Zakelijk", "count_text": "Trade & wederverkoop", "tag": "B2B", "featured": true } }
      ]
    }
  ]
}
{% endschema %}
