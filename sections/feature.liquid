<section class="feature-section" aria-labelledby="feat-heading">
  <div class="pb-container">
    <div class="pb-feat-grid">
      <div class="feat-image-outer" data-anim="slide-left">
        <div class="feat-image-wrap">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 800 | image_tag:
              alt: section.settings.image_alt | default: 'Feature afbeelding',
              loading: 'lazy'
            }}
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1485727749690-d091e8284ef3?auto=format&fit=crop&w=800&q=80" alt="Visser met vangst" loading="lazy">
          {%- endif -%}
          <div class="feat-image-overlay" aria-hidden="true"></div>
          {%- if section.settings.image_chip != blank -%}
            <div class="feat-image-chip">{{ section.settings.image_chip }}</div>
          {%- endif -%}
          {%- if section.settings.image_caption_title != blank -%}
            <div class="feat-image-caption" aria-hidden="true">
              {%- if section.settings.image_caption_sub != blank -%}
                <div class="feat-image-caption-sub">{{ section.settings.image_caption_sub }}</div>
              {%- endif -%}
              <div class="feat-image-caption-title">{{ section.settings.image_caption_title }}</div>
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.stat_value != blank -%}
          <div class="feat-stat" aria-label="{{ section.settings.stat_value }} {{ section.settings.stat_desc }}">
            <div class="feat-stat-value">{{ section.settings.stat_value }}</div>
            <div class="feat-stat-desc">{{ section.settings.stat_desc }}</div>
          </div>
        {%- endif -%}
      </div>

      <div data-anim="slide-right">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pb-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="pb-display feat-headline" id="feat-heading">
          {{ section.settings.heading }}<br>
          <span style="color:var(--mid-green)">{{ section.settings.heading_accent }}</span>
        </h2>
        {%- if section.settings.body != blank -%}
          <p class="feat-body">{{ section.settings.body }}</p>
        {%- endif -%}

        <div class="feat-points pb-feat-pts">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' -%}
              <div class="feat-point" {{ block.shopify_attributes }}>
                <span class="feat-point-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <p class="feat-point-title">{{ block.settings.title }}</p>
                <p class="feat-point-desc">{{ block.settings.description }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="feat-cta">
            {{ section.settings.cta_label }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature sectie",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "text", "id": "image_alt", "label": "Afbeelding alt tekst" },
    { "type": "text", "id": "image_chip", "label": "Chip op afbeelding", "default": "Field Tested" },
    { "type": "text", "id": "image_caption_sub", "label": "Bijschrift locatie", "default": "Karpermeer · NL" },
    { "type": "text", "id": "image_caption_title", "label": "Bijschrift titel", "default": "Pellet Drop 2026" },
    { "type": "text", "id": "stat_value", "label": "Statistiek waarde", "default": "+47%" },
    { "type": "text", "id": "stat_desc", "label": "Statistiek omschrijving", "default": "meer beten dankzij onze unieke formule (onafhankelijke test, 2025)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kwaliteit & resultaat" },
    { "type": "text", "id": "heading", "label": "Koptekst", "default": "Ontworpen voor" },
    { "type": "text", "id": "heading_accent", "label": "Koptekst accent", "default": "maximale aantrekkingskracht." },
    { "type": "textarea", "id": "body", "label": "Bodytekst", "default": "Pellet Baits biedt jou het meest uitgebreide assortiment vispellets van Alltech Coppens. Of je nu vist op karper, meerval of de kleinere witvissoorten — voor iedere vis of vistechniek hebben wij dé geschikte pellets." },
    { "type": "text", "id": "cta_label", "label": "Knoptekst", "default": "Lees de wetenschap" },
    { "type": "url", "id": "cta_url", "label": "Knop URL" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Punt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "text", "id": "description", "label": "Omschrijving" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature sectie",
      "blocks": [
        { "type": "point", "settings": { "title": "+47% meer beten", "description": "Onze unieke pellet-formule trekt aantoonbaar meer vis aan dan standaard halibut pellets." } },
        { "type": "point", "settings": { "title": "Door anglers, voor anglers", "description": "Iedere mix wordt op het water getest door ons team en topvissers in Nederland & België." } },
        { "type": "point", "settings": { "title": "Officieel Coppens distributeur", "description": "Direct vanuit eigen voorraad. Geen tussenhandel, altijd verse pellets." } },
        { "type": "point", "settings": { "title": "Advies op maat", "description": "Twijfel je over de juiste pellet voor jouw vistechniek? Wij denken met je mee." } }
      ]
    }
  ]
}
{% endschema %}
